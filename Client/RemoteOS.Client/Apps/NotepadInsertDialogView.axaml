<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Client.Apps"
             x:Class="Client.Apps.NotepadInsertDialogView"
             x:DataType="app:NotepadInsertDialogViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="20" RowSpacing="12">
        <TextBlock Text="输入要插入到记事本中的文本：" Foreground="#333333" />
        <TextBox x:Name="InputBox" Grid.Row="1" Text="{Binding Input}" MinHeight="80"
                 AcceptsReturn="True" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="从子对话框添加…" Command="{Binding AddFromNestedDialogCommand}" />
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Classes="primary" Content="插入" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
