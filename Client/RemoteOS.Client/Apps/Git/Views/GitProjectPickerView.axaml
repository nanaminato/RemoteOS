<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:Client.Apps.Git"
             xmlns:proto="clr-namespace:RemoteOS.Protocol.Git;assembly=RemoteOS.Protocol"
             x:Class="Client.Apps.Git.Views.GitProjectPickerView"
             x:DataType="git:GitClientViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="24,18,24,12" BoxShadow="0 1 4 0 #18000000">
            <StackPanel Spacing="4">
                <TextBlock Text="选择 Git 项目" FontSize="20" FontWeight="SemiBold" Foreground="#122344" />
                <TextBlock Text="每个项目以独立窗口打开；可同时管理多个项目。" FontSize="12" Foreground="#666" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 主体 -->
        <ScrollViewer Grid.Row="1" Padding="24,12" Background="#F4F7FB">
            <StackPanel Spacing="14">
                <!-- 已注册项目列表 -->
                <Border Background="White" CornerRadius="8" Padding="12" BoxShadow="0 2 8 0 #10000000">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="已注册项目" FontSize="14" FontWeight="SemiBold" Foreground="#122344" />
                            <Button Grid.Column="1" Content="⟳" Command="{Binding RefreshRepositoriesCommand}"
                                    Background="Transparent" Foreground="#36506F" BorderThickness="0" Padding="8,2" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Repositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="proto:GitRepositoryDto">
                                    <Button Click="OpenProject_Click" Tag="{Binding}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Background="Transparent" Foreground="#36506F" BorderThickness="0"
                                            Padding="10,8" Margin="0,2" CornerRadius="4">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="📁" FontSize="14" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#122344" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#888" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="还没有已注册项目，点击下方按钮打开一个文件夹作为新项目。"
                                   FontSize="12" Foreground="#999" Margin="4,8"
                                   IsVisible="{Binding Repositories.Count, Converter={x:Static git:GitPickerConverters.IsZeroToVisible}}" />
                    </StackPanel>
                </Border>

                <!-- 探测提示 -->
                <Border Background="White" CornerRadius="8" Padding="12" BoxShadow="0 2 8 0 #10000000"
                        IsVisible="{Binding IsProbing}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ProbeHint}" FontSize="12" Foreground="#36506F" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Height="4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作按钮 -->
        <Border Grid.Row="2" Background="#FFFFFF" Padding="24,10" BoxShadow="0 -1 4 0 #18000000">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="📂 打开文件夹作为项目" Command="{Binding OpenFolderCommand}"
                        Background="#1C3765" Foreground="White" Padding="14,6" />
                <Button Content="✎ 手动注册路径" Command="{Binding RegisterRepositoryCommand}"
                        Background="Transparent" Foreground="#36506F" BorderBrush="#C9D6EA" BorderThickness="1" Padding="14,6" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
