<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:Client.Apps.Git"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:proto="clr-namespace:RemoteOS.Protocol.Git;assembly=RemoteOS.Protocol"
             x:Class="Client.Apps.Git.Views.GitPushDialog"
             x:DataType="git:GitClientViewModel">
    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <!-- Row 0: Branch line + commit count -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="BranchLineText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1C3765"
                       Cursor="Hand"
                       Text="{Binding PushBranchLineText}"
                       PointerPressed="BranchLine_PointerPressed"/>
            <TextBlock FontSize="12"
                       Foreground="#666"
                       Margin="8,0,0,0"
                       Text="{Binding PushCommitCount, Converter={x:Static git:GitPickerConverters.LocalizedFormat}, ConverterParameter='git.dialog.push.n_commits_format'}"/>
        </StackPanel>

        <!-- Row 1: Two-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: commit list -->
            <StackPanel Grid.Column="0">
                <Button x:Name="AllCommitsButton"
                        Content="{loc:Loc git.dialog.push.all_commits}"
                        Classes.active="{Binding PushAllCommitsActive}"
                        FontSize="12"
                        Padding="8,6"
                        Foreground="#1C3765"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,4"
                        Click="AllCommits_Click">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="Button.active">
                            <Setter Property="Background" Value="#DCE9FF"/>
                        </Style>
                    </Button.Styles>
                </Button>
                <ListBox x:Name="CommitList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ItemsSource="{Binding PushCommits}"
                         SelectionChanged="CommitList_SelectionChanged">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="#DCE9FF"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="proto:GitCommitDto">
                            <Border Padding="8,6">
                                <TextBlock FontSize="12"
                                           Foreground="#122344"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           Text="{Binding Subject}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Right: file-change tree, with commit metadata only for a concrete commit selection. -->
            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="8">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="4">
                    <TextBlock FontSize="11"
                               Foreground="#666"
                               Margin="0,4,0,0"
                               Text="{Binding PushFileCount, Converter={x:Static git:GitPickerConverters.LocalizedFormat}, ConverterParameter='git.dialog.push.n_files_format'}"/>

                    <TreeView Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              ItemsSource="{Binding PushFileTree}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="git:PushFileTreeNode" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="2">
                                    <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               Foreground="#122344"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Border IsVisible="{Binding IsFile}"
                                            CornerRadius="3"
                                            Padding="4,0"
                                            Background="#0078D4">
                                        <TextBlock FontSize="10" Foreground="White" Text="{Binding Status}"/>
                                    </Border>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Never shown for the aggregate all-commits activity. -->
                    <Border Grid.Row="2"
                            x:Name="CommitInfoBorder"
                            Background="#F8FAFC"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,8,0,0"
                            IsVisible="{Binding PushHasSelectedCommit}">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#122344"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding PushSelectedCommit.Subject}"/>
                            <TextBlock FontSize="11"
                                       Foreground="#666"
                                       Margin="0,4,0,0"
                                       Text="{Binding PushSelectedCommit, Converter={x:Static git:GitPickerConverters.CommitMeta}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Push button + Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc git.dialog.push.push}"
                    Background="#1C3765"
                    Foreground="White"
                    Padding="20,6"
                    Click="Push_Click"/>
            <Button Content="{loc:Loc git.dialog.push.cancel}"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
