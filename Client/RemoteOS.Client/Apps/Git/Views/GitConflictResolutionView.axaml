<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:Client.Apps.Git"
             xmlns:proto="clr-namespace:RemoteOS.Protocol.Git;assembly=RemoteOS.Protocol"
             x:Class="Client.Apps.Git.Views.GitConflictResolutionView"
             x:DataType="git:GitClientViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <Border Background="#FFF3E0" CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="⚠ Merge Conflicts" FontSize="14" FontWeight="SemiBold" Foreground="#D44" />
                    <TextBlock Text="Resolve conflicts below, then continue the merge." FontSize="12" Foreground="#744" />
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" BoxShadow="0 2 8 0 #10000000">
                <ItemsControl ItemsSource="{Binding ConflictFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="proto:GitFileChangeDto">
                            <Border Background="#FAFAFA" CornerRadius="4" Padding="8" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Path}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="#888" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
