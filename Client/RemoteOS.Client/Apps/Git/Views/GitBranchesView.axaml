<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:Client.Apps.Git"
             x:Class="Client.Apps.Git.Views.GitBranchesView"
             x:DataType="git:GitClientViewModel">
    <Grid RowDefinitions="Auto,*" MinHeight="300">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="➕ New Branch" Command="{Binding CreateBranchCommand}" />
            <Button Content="🔄 Checkout" Click="Checkout_Click" />
            <Button Content="🗑 Delete" Click="Delete_Click" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4" BoxShadow="0 2 8 0 #10000000">
            <DataGrid x:Name="BranchGrid" ItemsSource="{Binding Branches}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                      CanUserResizeColumns="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" CanUserResize="True" />
                    <DataGridCheckBoxColumn Header="Current" Binding="{Binding IsCurrent}" IsReadOnly="True" Width="70" CanUserResize="True" />
                    <DataGridCheckBoxColumn Header="Remote" Binding="{Binding IsRemote}" IsReadOnly="True" Width="70" CanUserResize="True" />
                    <DataGridTextColumn Header="Upstream" Binding="{Binding Tracking}" Width="*" CanUserResize="True" />
                    <DataGridTextColumn Header="Ahead" Binding="{Binding Ahead}" Width="70" CanUserResize="True" />
                    <DataGridTextColumn Header="Behind" Binding="{Binding Behind}" Width="70" CanUserResize="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
