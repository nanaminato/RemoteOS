<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:Client.Apps.Git"
             xmlns:views="clr-namespace:Client.Apps.Git.Views"
             x:Class="Client.Apps.Git.Views.GitClientWorkspace"
             x:DataType="git:GitClientViewModel"
             Background="#F4F7FB">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top title bar -->
        <Border Grid.Row="0" Background="#122344" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="🌿" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="Git Client" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Repository version control" FontSize="11" Foreground="#B8C9E6" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding !IsPickerMode}">
                    <Border Background="#1C3765" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding Status.Branch}" Foreground="#C8F6DD" FontSize="12" />
                    </Border>
                    <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" Background="#1C3765" Foreground="#C8F6DD" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="190,*" IsVisible="{Binding !IsPickerMode}">
            <!-- Left navigation -->
            <Border Grid.Column="0" Background="#EEF3FA">
                <StackPanel Spacing="0" Margin="0,8">
                    <Button Content="📋 概览" Tag="overview" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#36506F" BorderThickness="0" Padding="16,10" />
                    <Button Content="📝 工作区" Tag="workspace" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#36506F" BorderThickness="0" Padding="16,10" />
                    <Button Content="📜 日志" Tag="log" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#36506F" BorderThickness="0" Padding="16,10" />
                    <Button Content="🌐 远程仓库" Tag="remotes" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#36506F" BorderThickness="0" Padding="16,10" />
                    <Button Content="⚠ 冲突" Tag="conflicts" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#36506F" BorderThickness="0" Padding="16,10"
                            IsVisible="{Binding HasConflicts}" />
                </StackPanel>
            </Border>

            <!-- Right content area: 不使用外层 ScrollViewer，避免给子元素无限宽高；
                 横向滚动与列表纵向滚动统一交给内部 DataGrid 自带的 ScrollViewer -->
            <Border Grid.Column="1" Padding="16">
                <ContentControl x:Name="ContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- 项目选择视图：IsPickerMode=true 时显示 -->
        <views:GitProjectPickerView Grid.Row="1" IsVisible="{Binding IsPickerMode}" x:Name="PickerHost" />

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#122344" Padding="16,6">
            <TextBlock Text="{Binding StatusText}" Foreground="#B8C9E6" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
