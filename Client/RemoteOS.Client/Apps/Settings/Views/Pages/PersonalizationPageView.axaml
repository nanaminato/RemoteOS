<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:vm="clr-namespace:Client.Apps.Settings.ViewModels"
             xmlns:ss="clr-namespace:Client.Services"
             x:Class="Client.Apps.Settings.Views.Pages.PersonalizationPageView"
             x:DataType="vm:PersonalizationPageViewModel">
    <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Text="{Binding LocalizedDisplayName}" FontSize="24" FontWeight="SemiBold" />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.wallpaper}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.wallpaper.description}" Opacity="0.7" />
                <Button Content="{loc:Loc settings.wallpaper.choose_image}"
                        Command="{Binding ChooseImageCommand}"
                        HorizontalAlignment="Left" />
                <TextBlock Text="{loc:Loc settings.wallpaper.sync_hint}" Opacity="0.6" FontSize="12" />
                <ListBox ItemsSource="{Binding Wallpapers}"
                         SelectedIndex="{Binding WallpaperIndex, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="ss:WallpaperOption">
                            <Grid ColumnDefinitions="44,*" Height="40" Margin="0,2">
                                <Border Grid.Column="0" Width="36" Height="26" CornerRadius="4"
                                        Background="{Binding Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.theme}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.theme.description}" Opacity="0.7" />
                <StackPanel Spacing="6">
                    <RadioButton Content="{loc:Loc settings.theme.light}" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                    <RadioButton Content="{loc:Loc settings.theme.dark}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    <RadioButton Content="{loc:Loc settings.theme.system}" IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.palette}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.palette.description}" Classes="subtle" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding PaletteChoices}"
                          SelectedValue="{Binding PaletteId, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Id}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemePaletteChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Loc settings.accent}" Classes="title" />
                <TextBox Text="{Binding AccentOverride, Mode=TwoWay}"
                         Watermark="{loc:Loc settings.accent.placeholder}" />
                <TextBlock Text="{loc:Loc settings.accent.hint}" Classes="subtle" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
