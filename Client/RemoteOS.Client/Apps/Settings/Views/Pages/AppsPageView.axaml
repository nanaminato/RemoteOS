<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Client.Apps.Settings.ViewModels"
             xmlns:d="clr-namespace:RemoteOS.Core.Applications;assembly=RemoteOS.Core"
             x:Class="Client.Apps.Settings.Views.Pages.AppsPageView"
             x:DataType="vm:AppsPageViewModel"
             x:Name="Root">
    <StackPanel Spacing="16" MaxWidth="720">
        <StackPanel IsVisible="{Binding IsInstalledApps}" Spacing="16">
            <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="已安装的 RemoteOS 应用。选择应用可查看信息、管理权限、打开或卸载。" Opacity="0.68" TextWrapping="Wrap" />
            <Border Classes="card">
                <ItemsControl ItemsSource="{Binding RegisteredApps}">
                    <ItemsControl.Styles>
                        <!-- Item presenters otherwise size to the button's content instead of the list width. -->
                        <Style Selector="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="d:ApplicationInfo">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.ShowAppDetailsCommand, ElementName=Root}" CommandParameter="{Binding}">
                                <Grid Height="56" ColumnDefinitions="36,*,Auto" Margin="2" ColumnSpacing="8">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="20" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="12" Opacity="0.62"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="110" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="{Binding ActionStatus}" IsVisible="{Binding HasActionStatus}" Opacity="0.68" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsAppDetails}" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="← 应用" Command="{Binding ShowInstalledAppsCommand}" />
                <TextBlock Text="应用信息" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="38,*" ColumnSpacing="10">
                        <TextBlock Text="{Binding SelectedApp.IconGlyph}" FontSize="26" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding SelectedApp.DisplayName}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedApp.Id}" FontSize="12" Opacity="0.62" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SelectedApp.Description}" TextWrapping="Wrap" Opacity="0.78" />
                    <Grid ColumnDefinitions="120,*"><TextBlock Text="版本" Opacity="0.65" /><TextBlock Grid.Column="1" Text="{Binding SelectedApp.Version}" /></Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="打开" Command="{Binding OpenSelectedAppCommand}" Padding="16,7" />
                        <Button Content="卸载" Command="{Binding UninstallSelectedAppCommand}" IsVisible="{Binding CanUninstallSelectedApp}" Padding="16,7" />
                    </StackPanel>
                    <TextBlock Text="{Binding UninstallAvailabilityText}" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="应用权限" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedAppPermissionSummary}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="管理权限" Command="{Binding EditSelectedPermissionsCommand}" IsVisible="{Binding HasSelectedAppPermissions}" VerticalAlignment="Center" Padding="14,6" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding ActionStatus}" IsVisible="{Binding HasActionStatus}" Opacity="0.68" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
