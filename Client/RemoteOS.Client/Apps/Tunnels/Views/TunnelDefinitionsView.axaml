<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:vm="clr-namespace:Client.Apps.Tunnels" x:Class="Client.Apps.Tunnels.Views.TunnelDefinitionsView" x:DataType="vm:TunnelManagerViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{loc:Loc tunnels.items}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{loc:Loc tunnels.edit_tunnel}" Command="{Binding EditTunnelCommand}"/><Button Grid.Column="2" Classes="primary" Content="{loc:Loc tunnels.new_tunnel}" Command="{Binding NewTunnelCommand}"/></Grid><TextBlock Text="{loc:Loc tunnels.items_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><DataGrid ItemsSource="{Binding Tunnels}" SelectedItem="{Binding SelectedTunnel, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal" MinHeight="360"><DataGrid.Columns><DataGridTextColumn Header="{loc:Loc tunnels.table.name}" Binding="{ReflectionBinding Name}" Width="*"/><DataGridTextColumn Header="{loc:Loc tunnels.table.protocol}" Binding="{ReflectionBinding Protocol}" Width="110"/><DataGridTextColumn Header="{loc:Loc tunnels.table.local}" Binding="{ReflectionBinding LocalHost}" Width="180"/><DataGridTextColumn Header="{loc:Loc tunnels.table.state}" Binding="{ReflectionBinding State}" Width="150"/></DataGrid.Columns></DataGrid></StackPanel></Border>
</UserControl>
