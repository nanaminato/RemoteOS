<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:vm="clr-namespace:Client.Apps.Tunnels" xmlns:tunnels="clr-namespace:RemoteOS.Protocol.Tunnels;assembly=RemoteOS.Protocol" x:Class="Client.Apps.Tunnels.Views.TunnelDefinitionsView" x:DataType="vm:TunnelManagerViewModel">
  <StackPanel Spacing="18"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc tunnels.items}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{loc:Loc tunnels.new_tunnel}" Command="{Binding NewTunnelCommand}"/></Grid><TextBlock Text="{loc:Loc tunnels.items_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><DataGrid ItemsSource="{Binding Tunnels}" SelectedItem="{Binding SelectedTunnel, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal" MinHeight="220"><DataGrid.Columns><DataGridTextColumn Header="{loc:Loc tunnels.table.name}" Binding="{ReflectionBinding Name}" Width="*"/><DataGridTextColumn Header="{loc:Loc tunnels.table.protocol}" Binding="{ReflectionBinding Protocol}" Width="110"/><DataGridTextColumn Header="{loc:Loc tunnels.table.local}" Binding="{ReflectionBinding LocalHost}" Width="180"/><DataGridTextColumn Header="{loc:Loc tunnels.table.state}" Binding="{ReflectionBinding State}" Width="150"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc tunnels.tunnel_editor}" FontSize="19" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="9"><StackPanel><TextBlock Text="{loc:Loc tunnels.field.name}"/><TextBox Text="{Binding TunnelName, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.server}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding TunnelProfile, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="tunnels:TunnelServerProfileDto"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="{loc:Loc tunnels.field.protocol}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding TunnelProtocol, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.local_host}"/><TextBox Text="{Binding TunnelLocalHost, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="{loc:Loc tunnels.field.local_port}"/><TextBox Text="{Binding TunnelLocalPort, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.remote_port}"/><TextBox Text="{Binding TunnelRemotePort, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="3" Grid.ColumnSpan="2"><TextBlock Text="{loc:Loc tunnels.field.domain}"/><TextBox Text="{Binding TunnelDomain, Mode=TwoWay}"/></StackPanel></Grid><WrapPanel ItemHeight="32" Margin="0,4,0,0"><CheckBox Content="{loc:Loc tunnels.field.enabled}" IsChecked="{Binding TunnelEnabled, Mode=TwoWay}" Margin="0,0,14,0"/><CheckBox Content="{loc:Loc tunnels.field.encryption}" IsChecked="{Binding TunnelEncryption, Mode=TwoWay}" Margin="0,0,14,0"/><CheckBox Content="{loc:Loc tunnels.field.compression}" IsChecked="{Binding TunnelCompression, Mode=TwoWay}"/></WrapPanel><WrapPanel Margin="0,6,0,0"><Button Classes="primary" Content="{loc:Loc common.save}" Command="{Binding SaveTunnelCommand}" Margin="0,0,8,0"/><CheckBox Content="{loc:Loc tunnels.confirm_delete}" IsChecked="{Binding ConfirmTunnelDeletion, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center"/><Button Content="{loc:Loc common.delete}" Command="{Binding DeleteTunnelCommand}" Foreground="{DynamicResource DangerBrush}"/></WrapPanel></StackPanel></Border></StackPanel>
</UserControl>
