<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:vm="clr-namespace:Client.Apps.Tunnels" x:Class="Client.Apps.Tunnels.Views.TunnelServersView" x:DataType="vm:TunnelManagerViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{loc:Loc tunnels.servers}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{loc:Loc tunnels.edit_server}" Command="{Binding EditProfileCommand}"/><Button Grid.Column="2" Classes="primary" Content="{loc:Loc tunnels.new_server}" Command="{Binding NewProfileCommand}"/></Grid><TextBlock Text="{loc:Loc tunnels.servers_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal" MinHeight="300"><DataGrid.Columns><DataGridTextColumn Header="{loc:Loc tunnels.table.name}" Binding="{ReflectionBinding Name}" Width="*"/><DataGridTextColumn Header="{loc:Loc tunnels.table.host}" Binding="{ReflectionBinding Host}" Width="180"/><DataGridTextColumn Header="{loc:Loc tunnels.table.port}" Binding="{ReflectionBinding Port}" Width="90"/><DataGridTextColumn Header="{loc:Loc tunnels.table.runtime}" Binding="{ReflectionBinding RuntimeMode}" Width="120"/><DataGridTemplateColumn Header="{loc:Loc tunnels.table.actions}" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{loc:Loc tunnels.view_logs}" Click="OpenLogsButton_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><WrapPanel><Button Classes="primary" Content="{loc:Loc tunnels.apply}" Command="{Binding ApplySelectedCommand}" Margin="0,0,8,0"/><Button Content="{loc:Loc tunnels.stop}" Command="{Binding StopSelectedCommand}"/></WrapPanel></StackPanel></Border>
</UserControl>
