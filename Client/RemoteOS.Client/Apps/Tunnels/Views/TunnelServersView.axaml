<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:vm="clr-namespace:Client.Apps.Tunnels" x:Class="Client.Apps.Tunnels.Views.TunnelServersView" x:DataType="vm:TunnelManagerViewModel">
  <StackPanel Spacing="18"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc tunnels.servers}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{loc:Loc tunnels.new_server}" Command="{Binding NewProfileCommand}"/></Grid><TextBlock Text="{loc:Loc tunnels.servers_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal" MinHeight="180"><DataGrid.Columns><DataGridTextColumn Header="{loc:Loc tunnels.table.name}" Binding="{ReflectionBinding Name}" Width="*"/><DataGridTextColumn Header="{loc:Loc tunnels.table.host}" Binding="{ReflectionBinding Host}" Width="180"/><DataGridTextColumn Header="{loc:Loc tunnels.table.port}" Binding="{ReflectionBinding Port}" Width="90"/><DataGridTextColumn Header="{loc:Loc tunnels.table.runtime}" Binding="{ReflectionBinding RuntimeMode}" Width="120"/></DataGrid.Columns></DataGrid><WrapPanel><Button Classes="primary" Content="{loc:Loc tunnels.apply}" Command="{Binding ApplySelectedCommand}" Margin="0,0,8,0"/><Button Content="{loc:Loc tunnels.stop}" Command="{Binding StopSelectedCommand}"/></WrapPanel></StackPanel></Border><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc tunnels.server_editor}" FontSize="19" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="9"><StackPanel><TextBlock Text="{loc:Loc tunnels.field.name}"/><TextBox Text="{Binding ProfileName, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.host}"/><TextBox Text="{Binding ProfileHost, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="{loc:Loc tunnels.field.port}"/><TextBox Text="{Binding ProfilePort, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.runtime_mode}"/><ComboBox ItemsSource="{Binding RuntimeModes}" SelectedItem="{Binding ProfileRuntimeMode, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="{loc:Loc tunnels.field.auth}"/><ComboBox ItemsSource="{Binding AuthKinds}" SelectedItem="{Binding ProfileAuthKind, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.tls}"/><ComboBox ItemsSource="{Binding TlsModes}" SelectedItem="{Binding ProfileTlsMode, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding !IsManagedProfile}"><TextBlock Text="{loc:Loc tunnels.field.external_path}"/><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding ProfileExternalPath, Mode=TwoWay}"/><Button Grid.Column="1" Content="{loc:Loc tunnels.probe}" Command="{Binding ProbeExternalRuntimeCommand}" Margin="8,0,0,0"/></Grid></StackPanel></Grid><StackPanel IsVisible="{Binding IsTokenAuth}" Spacing="4"><TextBlock Text="{loc:Loc tunnels.field.token}"/><TextBox Text="{Binding ProfileToken, Mode=TwoWay}" PasswordChar="●" Watermark="{loc:Loc tunnels.token_hint}"/><TextBlock Text="{loc:Loc tunnels.token_safety}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><WrapPanel Margin="0,6,0,0"><Button Classes="primary" Content="{loc:Loc common.save}" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0"/><CheckBox Content="{loc:Loc tunnels.confirm_delete}" IsChecked="{Binding ConfirmProfileDeletion, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center"/><Button Content="{loc:Loc common.delete}" Command="{Binding DeleteProfileCommand}" Foreground="{DynamicResource DangerBrush}"/></WrapPanel></StackPanel></Border></StackPanel>
</UserControl>
