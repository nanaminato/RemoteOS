<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:vm="clr-namespace:Client.Apps.Tunnels" x:Class="Client.Apps.Tunnels.Views.TunnelLogsView" x:DataType="vm:TunnelManagerViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc tunnels.logs}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{loc:Loc tunnels.logs}" Command="{Binding LoadLogsCommand}"/></Grid><TextBlock Text="{loc:Loc tunnels.logs_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBox Text="{Binding LogsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" MinHeight="380" Watermark="{loc:Loc tunnels.logs_placeholder}"/></StackPanel></Border>
</UserControl>
