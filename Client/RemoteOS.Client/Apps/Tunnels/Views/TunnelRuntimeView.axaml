<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:vm="clr-namespace:Client.Apps.Tunnels" x:Class="Client.Apps.Tunnels.Views.TunnelRuntimeView" x:DataType="vm:TunnelManagerViewModel">
  <StackPanel Spacing="18"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc tunnels.runtime_page}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding RuntimeText}" FontSize="18"/><TextBlock Text="{loc:Loc tunnels.runtime_install_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><TextBlock Text="{loc:Loc tunnels.version}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding RuntimeVersion, Mode=TwoWay}"/><Button Grid.Column="2" Classes="primary" Content="{loc:Loc tunnels.install}" Command="{Binding InstallRuntimeCommand}"/></Grid><CheckBox Content="{loc:Loc tunnels.runtime_confirm}" IsChecked="{Binding RuntimeInstallConfirmed, Mode=TwoWay}"/><Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="8" Padding="12"><StackPanel Spacing="7"><TextBlock Text="{Binding RuntimeInstallationText}" FontWeight="SemiBold"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding RuntimeInstallationProgress}" IsIndeterminate="{Binding RuntimeInstallationInProgress}" Height="8"/></StackPanel></Border><Button Content="{loc:Loc tunnels.rollback}" Command="{Binding RollbackRuntimeCommand}" HorizontalAlignment="Left"/><TextBlock Text="{loc:Loc tunnels.runtime_platform_hint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
</UserControl>
