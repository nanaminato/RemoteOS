<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Client.Apps"
             xmlns:d="clr-namespace:RemoteOS.Protocol.Files;assembly=RemoteOS.Protocol"
             x:Class="Client.Apps.RemoteFilePickerView"
             x:DataType="app:RemoteFilePickerViewModel"
             Background="#FFFFFF" Width="680" Height="460">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Content="Up" Command="{Binding UpCommand}" />
            <TextBlock Grid.Column="1" Text="{Binding Location}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 DoubleTapped="Entries_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="d:FileSystemEntryDto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                        <TextBlock Text="{Binding Type, StringFormat='{}{0}'}" FontSize="12" Opacity="0.65" Width="75" />
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="Open" Command="{Binding OpenSelectedCommand}" />
        </Grid>
    </Grid>
</UserControl>
