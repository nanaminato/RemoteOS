<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:registry="clr-namespace:Client.Apps.Registry"
             x:Class="Client.Apps.Registry.RegistryView"
             x:DataType="registry:RegistryViewModel"
             Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
    <Menu><MenuItem Header="File"><MenuItem Header="New Value" Command="{Binding NewValueCommand}"/><MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/></MenuItem><MenuItem Header="Edit"><MenuItem Header="Modify" Command="{Binding EditSelectedCommand}"/><MenuItem Header="Delete" Command="{Binding DeleteCommand}"/></MenuItem><MenuItem Header="View"><MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/></MenuItem></Menu>
    <TextBox Grid.Row="1" Margin="0,6,0,8" IsReadOnly="True" Text="{Binding NavigationPath}"/>
    <Grid Grid.Row="2" ColumnDefinitions="250,5,*" RowDefinitions="*,Auto">
      <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0" Padding="4"><TreeView ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey, Mode=TwoWay}"><TreeView.ItemTemplate><TreeDataTemplate DataType="registry:RegistryKeyNode" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}"/></TreeDataTemplate></TreeView.ItemTemplate></TreeView></Border>
      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"/>
      <DataGrid Grid.Column="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" DoubleTapped="EntriesGrid_DoubleTapped" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True"><DataGrid.ContextMenu><ContextMenu><MenuItem Header="New" Click="NewValue_Click"/><MenuItem Header="Modify" Click="ModifyValue_Click"/><MenuItem Header="Delete" Click="DeleteValue_Click"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/><DataGridTextColumn Header="Data" Binding="{Binding DesiredValue}" Width="*"/></DataGrid.Columns></DataGrid>
    </Grid>
    <TextBlock Grid.Row="3" Margin="2,8,0,0" Text="{Binding StatusText}" Opacity="0.7"/>
  </Grid>
</UserControl>
