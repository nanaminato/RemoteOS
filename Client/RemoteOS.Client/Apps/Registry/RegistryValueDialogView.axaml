<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:registry="clr-namespace:Client.Apps.Registry" x:Class="Client.Apps.Registry.RegistryValueDialogView" x:DataType="registry:RegistryValueDialogViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" MinWidth="680" MinHeight="420">
    <Grid ColumnDefinitions="*,160,120" ColumnSpacing="8"><TextBlock Text="{Binding Path}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/><ComboBox Grid.Column="2" ItemsSource="{Binding ValueTypes}" SelectedItem="{Binding ValueType, Mode=TwoWay}"/></Grid>
    <TextBox Grid.Row="1" Margin="0,14" Text="{Binding ValueText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinHeight="300" FontFamily="Consolas"/>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"/><Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}"/></Grid>
  </Grid>
</UserControl>
