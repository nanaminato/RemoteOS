<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:app="clr-namespace:Client.Apps"
             xmlns:terminal="clr-namespace:Client.Apps.Terminal"
             x:Class="Client.Apps.Terminal.TerminalView"
             x:DataType="terminal:TerminalViewModel"
             Background="#0C0C0C">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <Menu Grid.Column="0" Background="Transparent" BorderThickness="0">
                    <MenuItem Header="{loc:Loc terminal.menu}">
                        <MenuItem Header="{loc:Loc terminal.settings}" Command="{Binding OpenSettingsCommand}" />
                    </MenuItem>
                </Menu>
                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"
                           Margin="6,0" Opacity="0.7" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="TerminalHost" />
    </Grid>
</UserControl>
