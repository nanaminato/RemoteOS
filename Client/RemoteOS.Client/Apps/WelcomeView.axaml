<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Client.Apps"
             x:Class="Client.Apps.WelcomeView"
             x:DataType="app:WelcomeViewModel"
             Background="#FFFFFF">
    <Grid RowDefinitions="Auto,*,Auto" Margin="28">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="🏠 RemoteOS" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="A cross-platform, cloud-native desktop environment." Opacity="0.8" FontSize="13" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Margin="0,18,0,0">
            <StackPanel Spacing="12">
                <TextBlock Text="功能概览" Classes="title" />
                <TextBlock TextWrapping="Wrap" Opacity="0.9"
                           Text="• 自定义窗口管理器 — 拖动、缩放、最小化、最大化、焦点与 Z 顺序，全部本地渲染。" />
                <TextBlock TextWrapping="Wrap" Opacity="0.9"
                           Text="• 桌面：桌面图标、任务栏（实时窗口列表）、开始菜单。" />
                <TextBlock TextWrapping="Wrap" Opacity="0.9"
                           Text="• 应用在本地运行并渲染 — RemoteOS 不是远程桌面工具。" />
                <TextBlock TextWrapping="Wrap" Opacity="0.9"
                           Text="• 内置应用：Welcome、Notepad、Settings、Terminal、Explorer、Browser、TaskManager。" />
                <TextBlock TextWrapping="Wrap" Opacity="0.9"
                           Text="• 服务端能力：登录认证（JWT + 宿主OS用户复用）、SQLite持久化、文件管理、系统监控、Workspace偏好同步。" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Classes="primary" Content="Open Notepad" Command="{Binding OpenNotepadCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
