<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:docker="clr-namespace:Client.Apps.Docker"
             x:Class="Client.Apps.Docker.Views.DockerStacksView"
             x:DataType="docker:DockerManagerViewModel">
    <Border Background="White" CornerRadius="14" Padding="20">
        <Grid RowDefinitions="Auto,Auto,Auto,210,Auto,Auto,180" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="{loc:Loc docker.orchestration}" FontSize="19" FontWeight="SemiBold" Foreground="#163059" />
                <Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" />
                <Button Grid.Column="2" Classes="primary" Content="{loc:Loc docker.stack.deploy}" Click="DeployStack_Click" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{loc:Loc docker.orchestration_hint}" Foreground="#61708B" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Text="{loc:Loc docker.stack.projects}" FontWeight="SemiBold" Foreground="#36506F" />
            <DataGrid Grid.Row="3" ItemsSource="{Binding Stacks}" SelectedItem="{Binding SelectedStack, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal" SelectionMode="Single" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc docker.table.name}" Binding="{ReflectionBinding Name}" Width="2*" />
                    <DataGridTextColumn Header="{loc:Loc docker.table.status}" Binding="{ReflectionBinding Status}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Row="4" ItemHeight="34" HorizontalAlignment="Left">
                <Button Content="{loc:Loc docker.action.start}" Command="{Binding StartStackCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Loc docker.action.stop}" Command="{Binding StopStackCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Loc docker.action.restart}" Command="{Binding RestartStackCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Loc docker.stack.refresh_services}" Command="{Binding LoadStackServicesCommand}" />
            </WrapPanel>
            <TextBlock Grid.Row="5" Text="{loc:Loc docker.stack.services}" FontWeight="SemiBold" Foreground="#36506F" />
            <DataGrid Grid.Row="6" ItemsSource="{Binding StackServices}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserReorderColumns="False" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc docker.table.service}" Binding="{ReflectionBinding Service}" Width="150" />
                    <DataGridTextColumn Header="{loc:Loc docker.table.container}" Binding="{ReflectionBinding Container}" Width="2*" />
                    <DataGridTextColumn Header="{loc:Loc docker.table.image}" Binding="{ReflectionBinding Image}" Width="2*" />
                    <DataGridTextColumn Header="{loc:Loc docker.table.state}" Binding="{ReflectionBinding State}" Width="100" />
                    <DataGridTextColumn Header="{loc:Loc docker.table.status}" Binding="{ReflectionBinding Status}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
