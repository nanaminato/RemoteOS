<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:docker="clr-namespace:Client.Apps.Docker"
             x:Class="Client.Apps.Docker.Views.DockerManagerWorkspace"
             x:DataType="docker:DockerManagerViewModel"
             Background="#F4F7FB">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#122344" Padding="28,18">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="46" Height="46" Background="#147CB8" CornerRadius="14">
                    <TextBlock Text="🐳" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc application.remoteos.docker.display_name}" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{loc:Loc docker.subtitle}" FontSize="13" Foreground="#B8C9E6" />
                </StackPanel>
                <Border Grid.Column="2" Background="#1C3765" CornerRadius="16" Padding="11,5" VerticalAlignment="Center">
                    <Button Content="{Binding StatusText}"
                            Command="{Binding OpenInstallGuideCommand}"
                            IsEnabled="{Binding IsDockerInstallRequired}"
                            ToolTip.Tip="{loc:Loc docker.status.open_install_guide}"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0"
                            FontSize="12" Foreground="#C8F6DD" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="190,*">
            <Border Grid.Column="0" Background="#EEF3FA" BorderBrush="#DCE5F1" BorderThickness="0,0,1,0">
                <StackPanel Spacing="4" Margin="14,22">
                    <TextBlock Text="{loc:Loc docker.workspace}" Foreground="#72819A" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" />
                    <Button x:Name="OverviewButton" Tag="overview" Click="NavigationButton_Click" Content="{loc:Loc docker.overview}" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="#36506F" />
                    <Button Tag="containers" Click="NavigationButton_Click" Content="{loc:Loc docker.containers}" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="#36506F" />
                    <Button Tag="stacks" Click="NavigationButton_Click" Content="{loc:Loc docker.stacks}" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="#36506F" />
                    <Button Tag="images" Click="NavigationButton_Click" Content="{loc:Loc docker.images}" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="#36506F" />
                    <Button Tag="networks" Click="NavigationButton_Click" Content="{loc:Loc docker.networks}" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="#36506F" />
                    <Button Tag="volumes" Click="NavigationButton_Click" Content="{loc:Loc docker.volumes}" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="#36506F" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1">
                <ContentControl x:Name="ContentHost" Margin="30,24" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
