<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:docker="clr-namespace:Client.Apps.Docker"
             x:Class="Client.Apps.Docker.Views.DockerPullImageDialogView"
             x:DataType="docker:DockerManagerViewModel">
    <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="16">
        <StackPanel Width="420" Spacing="4" HorizontalAlignment="Left"><TextBlock Text="{loc:Loc docker.image.reference}" Foreground="#36506F" /><TextBox Text="{Binding ImageReference, Mode=TwoWay}" PlaceholderText="nginx:latest" /></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.cancel}" Click="Cancel_Click" HorizontalContentAlignment="Center" />
            <Button Classes="primary" Content="{loc:Loc docker.image.pull}" Click="Pull_Click" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
