<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:docker="clr-namespace:Client.Apps.Docker"
             x:Class="Client.Apps.Docker.Views.DockerOverviewView"
             x:DataType="docker:DockerManagerViewModel">
    <StackPanel Spacing="18">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <Border Background="White" CornerRadius="14" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc docker.engine}" Foreground="#61708B" FontSize="12" />
                    <TextBlock Text="{Binding EngineVersion}" FontSize="24" FontWeight="SemiBold" Foreground="#163059" />
                    <TextBlock Text="{Binding EnginePlatform}" Foreground="#61708B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc docker.running_containers}" Foreground="#61708B" FontSize="12" />
                    <TextBlock Text="{Binding RunningContainerCount}" FontSize="24" FontWeight="SemiBold" Foreground="#163059" />
                    <TextBlock Text="{loc:Loc docker.running_hint}" Foreground="#61708B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Background="White" CornerRadius="14" Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Loc docker.overview}" FontSize="19" FontWeight="SemiBold" Foreground="#163059" />
                <TextBlock Text="{loc:Loc docker.overview_hint}" Foreground="#61708B" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="3"><TextBlock Text="{loc:Loc docker.containers}" Foreground="#61708B" /><TextBlock Text="{Binding Containers.Count}" FontSize="20" FontWeight="SemiBold" Foreground="#163059" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{loc:Loc docker.stacks}" Foreground="#61708B" /><TextBlock Text="{Binding Stacks.Count}" FontSize="20" FontWeight="SemiBold" Foreground="#163059" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="{loc:Loc docker.images}" Foreground="#61708B" /><TextBlock Text="{Binding Images.Count}" FontSize="20" FontWeight="SemiBold" Foreground="#163059" /></StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="{loc:Loc docker.networks}" Foreground="#61708B" /><TextBlock Text="{Binding Networks.Count}" FontSize="20" FontWeight="SemiBold" Foreground="#163059" /></StackPanel>
                    <StackPanel Grid.Column="4" Spacing="3"><TextBlock Text="{loc:Loc docker.volumes}" Foreground="#61708B" /><TextBlock Text="{Binding Volumes.Count}" FontSize="20" FontWeight="SemiBold" Foreground="#163059" /></StackPanel>
                </Grid>
                <Button Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <Border Background="#EDF4FF" BorderBrush="#CFE1FF" BorderThickness="1" CornerRadius="14" Padding="18">
            <TextBlock Text="{loc:Loc docker.safety_hint}" Foreground="#315582" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
