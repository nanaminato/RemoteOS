<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             x:Class="Client.Apps.Docker.Views.DockerLoginRequiredView">
    <TextBlock Margin="24" Text="{loc:Loc docker.login_required}" TextWrapping="Wrap" />
</UserControl>
