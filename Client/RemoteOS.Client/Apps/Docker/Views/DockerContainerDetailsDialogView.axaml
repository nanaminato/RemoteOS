<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:docker="clr-namespace:Client.Apps.Docker"
             x:Class="Client.Apps.Docker.Views.DockerContainerDetailsDialogView"
             x:DataType="docker:DockerManagerViewModel">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="{loc:Loc docker.container.details_copy_hint}" Foreground="#61708B" TextWrapping="Wrap" />
        <TextBox Grid.Row="1" Text="{Binding ContainerDetailsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono,Consolas,monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.copy}" Click="Copy_Click" />
            <Button Content="{loc:Loc common.close}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</UserControl>
