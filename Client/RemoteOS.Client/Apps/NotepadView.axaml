<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Client.Apps"
             x:Class="Client.Apps.NotepadView"
             x:DataType="app:NotepadViewModel"
             Background="#1E1E1E">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#262626" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="New" Command="{Binding NewDocumentCommand}" />
                <TextBlock Text="Untitled" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" />
            </StackPanel>
        </Border>

        <TextBox Grid.Row="1"
                 Text="{Binding Text}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 CornerRadius="0"
                 Padding="12,10"
                 FontFamily="Consolas, Cascadia Mono, monospace"
                 FontSize="14"
                 CaretBrush="#4CC2FF" />

        <Border Grid.Row="2" Background="#262626" Padding="12,5">
            <TextBlock Text="{Binding CharCount, StringFormat='{}{0} characters'}"
                       FontSize="12" Opacity="0.7" />
        </Border>
    </Grid>
</UserControl>
