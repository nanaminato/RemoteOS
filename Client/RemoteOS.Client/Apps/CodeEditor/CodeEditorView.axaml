<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Client.Apps"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:codeEditor="clr-namespace:Client.Apps.CodeEditor"
             x:Class="Client.Apps.CodeEditor.CodeEditorView"
             x:DataType="codeEditor:CodeEditorViewModel"
             Background="#FFFFFF">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <Menu Grid.Column="0" Background="Transparent" BorderThickness="0">
                    <MenuItem Header="File">
                        <MenuItem Header="New" Command="{Binding NewDocumentCommand}" />
                        <MenuItem Header="Open..." Command="{Binding OpenDocumentCommand}" />
                        <Separator />
                        <MenuItem Header="Save" Command="{Binding SaveCommand}" />
                        <MenuItem Header="Save as..." Command="{Binding SaveAsCommand}" />
                    </MenuItem>
                    <MenuItem Header="Settings">
                        <MenuItem Header="Preferences..." Command="{Binding OpenSettingsCommand}" />
                    </MenuItem>
                </Menu>
                <TextBlock Grid.Column="1" Text="{Binding DocumentName}" VerticalAlignment="Center"
                           Margin="10,0" Opacity="0.7" />
            </Grid>
        </Border>

        <editor:TextEditor Grid.Row="1"
                           Name="Editor"
                           ShowLineNumbers="True"
                           WordWrap="{Binding WordWrap}"
                           BorderThickness="0"
                           Padding="12,10"
                           FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                           FontSize="{Binding FontSize}" />

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding LineCount, StringFormat='{}Ln {0}'}" FontSize="12" Opacity="0.7" />
                <TextBlock Grid.Column="2" Text="{Binding CharCount, StringFormat='{}{0} characters'}" FontSize="12" Opacity="0.7" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
