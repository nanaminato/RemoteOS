<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:vm="clr-namespace:Client.Apps.PortForwarding.ViewModels"
             x:Class="Client.Apps.PortForwarding.Views.PortForwardingEditorDialogView"
             x:DataType="vm:PortForwardingViewModel">
    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Margin="20" Spacing="10">
            <TextBlock Text="{loc:Loc port_forwarding.forward_service}" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc port_forwarding.editor_note}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc port_forwarding.target_address}" FontWeight="SemiBold" />
            <TextBox Text="{Binding TargetAddress, Mode=TwoWay}" Watermark="http://localhost:7000" />
            <TextBlock Text="{loc:Loc port_forwarding.preferred_local_port}" FontWeight="SemiBold" />
            <TextBox Text="{Binding PreferredLocalPortText, Mode=TwoWay}" Watermark="Preferred local port" />
            <TextBlock Text="{loc:Loc port_forwarding.fallback_note}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="20,0,20,20">
            <Button Content="{loc:Loc common.cancel}" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Classes="primary" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
    </Grid>
</UserControl>
