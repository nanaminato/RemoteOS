<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Client.Apps.TaskManager.ViewModels"
             xmlns:conv="clr-namespace:Client.Apps.TaskManager.Converters"
             xmlns:dto="clr-namespace:RemoteOS.Protocol.SystemMonitor;assembly=RemoteOS.Protocol"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="Client.Apps.TaskManager.Views.TaskManagerMainView"
             x:DataType="vm:TaskManagerViewModel"
             Background="#FFFFFF">

    <UserControl.Resources>
        <!-- 标签页按钮：紧凑 -->
        <ControlTheme x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </ControlTheme>
    </UserControl.Resources>

    <!-- 指标卡片样式：按选择器自动应用到 Class="card" 的 Border -->
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">

        <!-- 顶部工具栏：标签页切换 + 刷新 + 状态 -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Background="#E5E5E5" Margin="0,0,8,0">
                    <Button Content="性能" Theme="{StaticResource TabButton}"
                            Command="{Binding SwitchToPerformanceCommand}"
                            Background="{Binding ActiveTab, Converter={x:Static conv:TabBgConverter.Instance}, ConverterParameter=Performance, Mode=OneWay}" />
                    <Button Content="进程" Theme="{StaticResource TabButton}"
                            Command="{Binding SwitchToProcessesCommand}"
                            Background="{Binding ActiveTab, Converter={x:Static conv:TabBgConverter.Instance}, ConverterParameter=Processes, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="⟳ 刷新" Command="{Binding RefreshCommand}" Padding="12,6" />
                    <CheckBox Content="自动刷新(2s)" IsChecked="{Binding IsAutoRefresh, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="3" Content="✕" Command="{Binding CloseCommand}"
                        Padding="10,4" ToolTip.Tip="关闭任务管理器" />
            </Grid>
        </Border>

        <!-- 内容区：性能 / 进程 两个面板叠加，按 ActiveTab 切换可见 -->
        <Grid>

            <!-- ════════ 性能面板 ════════ -->
            <ScrollViewer IsVisible="{Binding ActiveTab, Converter={x:Static conv:TabVisibilityConverter.Instance}, ConverterParameter=Performance, Mode=OneWay}"
                          Padding="12">
                <StackPanel Orientation="Vertical" MaxWidth="980">

                    <!-- CPU 卡片 -->
                    <Border Classes="card">
                        <StackPanel Orientation="Vertical" Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🖥 CPU" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Metrics.Cpu.CoreCount, StringFormat='{}{0} 核'}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" FontSize="26" FontWeight="Bold" Foreground="#0078D7"
                                           Text="{Binding Metrics.Cpu.TotalPercent, StringFormat='{}{0:0.0}%'}" />
                            </Grid>
                            <!-- 实时柱状图：纵向条形，值 0-100，容器 70px 高 ClipToBounds 裁剪 -->
                            <Border Height="70" ClipToBounds="True" Background="#F0F6FC" BorderBrush="#E5E5E5" BorderThickness="1">
                                <ItemsControl ItemsSource="{Binding CpuHistory}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:Double">
                                            <Rectangle Width="3" Height="{Binding}" VerticalAlignment="Bottom" Fill="#0078D7" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <!-- 每核占用 -->
                            <TextBlock Text="每核占用" FontSize="11" Opacity="0.6" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding Metrics.Cpu.PerCorePercent}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:Double">
                                        <StackPanel Orientation="Vertical" Width="90" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding StringFormat='{}{0:0}%'}" FontSize="10" Opacity="0.7" />
                                            <ProgressBar Value="{Binding}" Maximum="100" Height="5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 内存卡片 -->
                    <Border Classes="card">
                        <StackPanel Orientation="Vertical" Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="💾 内存" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" FontSize="26" FontWeight="Bold" Foreground="#107C10"
                                           Text="{Binding Metrics.Memory.Percent, StringFormat='{}{0:0.0}%'}" />
                            </Grid>
                            <Border Height="50" ClipToBounds="True" Background="#F2F8F2" BorderBrush="#E5E5E5" BorderThickness="1">
                                <ItemsControl ItemsSource="{Binding MemoryHistory}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:Double">
                                            <Rectangle Width="3" Height="{Binding}" VerticalAlignment="Bottom" Fill="#107C10" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="16" Opacity="0.75">
                                <TextBlock FontSize="12" Text="{Binding Metrics.Memory.UsedBytes, Converter={x:Static conv:BytesConverter.Instance}, StringFormat='已用 {0}'}" />
                                <TextBlock FontSize="12" Text="{Binding Metrics.Memory.AvailableBytes, Converter={x:Static conv:BytesConverter.Instance}, StringFormat='可用 {0}'}" />
                                <TextBlock FontSize="12" Text="{Binding Metrics.Memory.TotalBytes, Converter={x:Static conv:BytesConverter.Instance}, StringFormat='总计 {0}'}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 磁盘卡片 -->
                    <Border Classes="card">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="💿 磁盘" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Metrics.Disks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dto:DiskUsageDto">
                                        <Grid ColumnDefinitions="90,*,Auto" Margin="0,3" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" Height="14" Margin="8,0" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock FontSize="11" Opacity="0.75"
                                                           Text="{Binding UsedBytes, Converter={x:Static conv:BytesConverter.Instance}}" />
                                                <TextBlock Text="/" FontSize="11" Opacity="0.5" />
                                                <TextBlock FontSize="11" Opacity="0.75"
                                                           Text="{Binding TotalBytes, Converter={x:Static conv:BytesConverter.Instance}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 网络卡片 -->
                    <Border Classes="card">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="🌐 网络" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Metrics.Networks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dto:NetworkUsageDto">
                                        <Grid ColumnDefinitions="110,Auto,Auto,*" Margin="0,3" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="↓ " Foreground="#107C10" FontSize="12" />
                                                <TextBlock FontSize="12" Text="{Binding ReceiveRateBytesPerSec, Converter={x:Static conv:RateConverter.Instance}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="↑ " Foreground="#0078D7" FontSize="12" />
                                                <TextBlock FontSize="12" Text="{Binding SendRateBytesPerSec, Converter={x:Static conv:RateConverter.Instance}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- GPU 卡片 -->
                    <Border Classes="card" IsVisible="{Binding HasGpu}">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="🎮 GPU" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Metrics.Gpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dto:GpuUsageDto">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,3" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Text="{Binding UsagePercent, Converter={x:Static conv:NullableDoubleTextConverter.Instance}, StringFormat='利用率 {0}%'}" />
                                            <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Run Text="显存 " />
                                                <Run Text="{Binding MemoryUsedBytes, Converter={x:Static conv:BytesConverter.Instance}}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding MemoryTotalBytes, Converter={x:Static conv:BytesConverter.Instance}}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Text="{Binding TemperatureCelsius, Converter={x:Static conv:NullableDoubleTextConverter.Instance}, StringFormat='{}{0}°C'}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- GPU 不可用提示 -->
                    <TextBlock Text="{Binding GpuHint}" FontSize="11" Opacity="0.5" Margin="2,0,0,6"
                               IsVisible="{Binding !HasGpu}" />

                    <!-- 运行时间 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,6" Opacity="0.7">
                        <TextBlock Text="⏱ 运行时间：" FontSize="12" />
                        <TextBlock FontSize="12" Text="{Binding Metrics.UptimeSeconds, Converter={x:Static conv:UptimeConverter.Instance}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ════════ 进程面板 ════════ -->
            <Grid IsVisible="{Binding ActiveTab, Converter={x:Static conv:TabVisibilityConverter.Instance}, ConverterParameter=Processes, Mode=OneWay}"
                  RowDefinitions="Auto,Auto,*">

                <!-- 工具栏：过滤 + 结束任务 -->
                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="8,6">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Text="{Binding ProcessFilter, Mode=TwoWay}"
                                 PlaceholderText="按名称 / PID / 用户过滤..."
                                 KeyDown="FilterBox_KeyDown" />
                        <Button Grid.Column="1" Content="清除" Command="{Binding ClearFilterCommand}" Padding="12,6" Margin="6,0,0,0" />
                        <Button Grid.Column="2" Content="结束任务" Command="{Binding KillProcessCommand}"
                                Classes="primary" Padding="16,6" Margin="6,0,0,0"
                                ToolTip.Tip="结束所选进程（权限不足需在宿主 OS 提权）" />
                    </Grid>
                </Border>

                <!-- 结束进程反馈 -->
                <Border Grid.Row="1" Background="#FFF9E6" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="8,4"
                        IsVisible="{Binding KillFeedback, Converter={x:Static conv:StringNonEmptyVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding KillFeedback}" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- 进程列表 -->
                <Border Grid.Row="2">
                    <Grid RowDefinitions="Auto,*">
                        <!-- 表头 -->
                        <Border Grid.Row="0" Background="#F0F0F0" Padding="8,6">
                            <Grid ColumnDefinitions="2*,70,80,120,120,60">
                                <TextBlock Grid.Column="0" Text="名称" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="PID" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="CPU" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="内存" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="用户" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="线程" FontSize="12" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" x:Name="ProcessList"
                                 ItemsSource="{Binding FilteredProcesses}"
                                 SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:ProcessInfoDto">
                                    <Grid ColumnDefinitions="2*,70,80,120,120,60" Margin="0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat='{}{0:0.0}%'}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding MemoryBytes, Converter={x:Static conv:BytesConverter.Instance}}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding UserName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding ThreadCount}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Padding" Value="8,3" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
