<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Client.Apps"
             xmlns:ss="clr-namespace:Client.Services"
             x:Class="Client.Apps.SettingsView"
             x:DataType="app:SettingsViewModel"
             Background="#FFFFFF">
    <ScrollViewer Padding="22">
        <StackPanel Spacing="18">
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Wallpaper" Classes="title" />
                    <TextBlock Text="Choose a background for your desktop." Opacity="0.7" />
                    <ListBox ItemsSource="{Binding Settings.Wallpapers}"
                             SelectedIndex="{Binding Settings.WallpaperIndex}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ss:WallpaperOption">
                                <Grid ColumnDefinitions="44,*" Height="40" Margin="0,2">
                                    <Border Grid.Column="0" Width="36" Height="26" CornerRadius="4"
                                            Background="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="About" Classes="title" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="RemoteOS — a cross-platform, cloud-native desktop OS environment. Applications run and render locally; RemoteServer provides data, state, storage and compute." />
                    <TextBlock Text="MVP 0 · Desktop Shell" Opacity="0.6" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
