<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:webservers="clr-namespace:Client.Apps.WebServers"
             x:Class="Client.Apps.WebServers.Views.WebServerManagerWorkspace"
             x:DataType="webservers:WebServerManagerViewModel"
             Background="#F4F7FB">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Background="#122344" Padding="32,22">
            <Grid ColumnDefinitions="Auto,*">
                <Border Width="48" Height="48" Background="#147CB8" CornerRadius="14">
                    <TextBlock Text="🌐" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc application.remoteos.webservers.display_name}" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{loc:Loc webservers.subtitle}" FontSize="13" Foreground="#B8C9E6" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" IsVisible="{Binding HasOperationActivity}" Background="#EDF4FF" BorderBrush="#B8D4FA" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding OperationText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#163059" />
                <Button Grid.Column="1" Content="{loc:Loc common.stop}" Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsOperationRunning}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="190,*">
            <Border Grid.Column="0" Background="#EEF3FA" BorderBrush="#DCE5F1" BorderThickness="0,0,1,0">
                <StackPanel Spacing="4" Margin="14,22">
                    <TextBlock Text="工作区" Foreground="#72819A" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" />
                    <Button x:Name="InstancesPageButton" Tag="instances" Click="NavigationButton_Click" Content="实例管理" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="#36506F" />
                    <Button Tag="sites" Click="NavigationButton_Click" Content="站点部署" HorizontalContentAlignment="Left" Padding="10,8" Background="Transparent" Foreground="#36506F" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid x:Name="InstancesPage" MaxWidth="1440" HorizontalAlignment="Stretch" Margin="32,28,32,32" ColumnDefinitions="*,1.35*" ColumnSpacing="18">
                        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="24">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Nginx 实例" FontSize="16" FontWeight="SemiBold" Foreground="#163059" />
                                    <TextBlock Text="先选择需要管理的 Nginx 实例，再执行状态检查、安装或维护操作。" FontSize="12" Foreground="#61708B" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" />
                                    <Button Content="{loc:Loc webservers.discover}" Command="{Binding DiscoverCommand}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="已发现的 Nginx 实例" FontSize="12" Foreground="#61708B" />
                                    <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" PlaceholderText="选择 Nginx 实例">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding ManagementMode}" />
                                                    <TextBlock Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#163059" />
                                <StackPanel IsVisible="{Binding IsManagedInstallAvailable}" Spacing="8">
                                    <TextBlock Text="受管安装" FontWeight="SemiBold" Foreground="#36506F" />
                                    <StackPanel IsVisible="{Binding IsWindowsServer}" Spacing="6">
                                        <TextBlock Text="选择 Nginx 版本或上传本地 ZIP 包。" FontSize="12" Foreground="#61708B" />
                                        <ComboBox ItemsSource="{Binding AvailableWindowsVersions}" Text="{Binding InstallVersion, Mode=TwoWay}" IsEditable="True" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{loc:Loc webservers.managed.refresh_versions}" Command="{Binding RefreshWindowsVersionsCommand}" />
                                            <Button Content="{loc:Loc webservers.managed.select_package}" Command="{Binding SelectLocalPackageCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LocalPackageName}" TextWrapping="Wrap" Foreground="#61708B" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding IsLinuxServer}" Spacing="6">
                                        <TextBox PlaceholderText="{loc:Loc webservers.managed.version}" Text="{Binding InstallVersion}" />
                                        <TextBlock Text="{loc:Loc webservers.managed.linux_version_hint}" TextWrapping="Wrap" FontSize="12" Foreground="#61708B" />
                                    </StackPanel>
                                    <Button Classes="primary" Content="{loc:Loc webservers.managed.install}" Command="{Binding InstallManagedCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="24">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="实例操作" FontSize="16" FontWeight="SemiBold" Foreground="#163059" />
                                    <TextBlock Text="{Binding ManagementHint}" TextWrapping="Wrap" Foreground="#61708B" />
                                </StackPanel>
                                <Border Background="#F5F8FD" CornerRadius="10" Padding="14,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="运行状态" FontSize="11" FontWeight="SemiBold" Foreground="#61708B" />
                                        <TextBlock Text="{Binding SelectedStatusText}" TextWrapping="Wrap" Foreground="#163059" />
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Grid.Column="0" Content="{loc:Loc webservers.action.test_config}" Command="{Binding TestConfigurationCommand}" HorizontalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="{loc:Loc webservers.action.refresh_status}" Command="{Binding RefreshStatusCommand}" HorizontalContentAlignment="Center" />
                                </Grid>
                                <StackPanel IsVisible="{Binding IsExternalServer}" Spacing="8">
                                    <TextBlock Text="外部实例只能在符合条件时集成；集成后不会由 RemoteOS 接管进程生命周期。" FontSize="12" Foreground="#61708B" TextWrapping="Wrap" />
                                    <Button Classes="primary" Content="{loc:Loc webservers.action.integrate}" Command="{Binding IntegrateCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsIntegratedServer}" Spacing="8">
                                    <TextBlock Text="已集成实例可重载配置，以应用站点变更。" FontSize="12" Foreground="#61708B" />
                                    <Button Content="{loc:Loc webservers.action.reload}" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsManagedServer}" Spacing="10">
                                    <TextBlock Text="服务控制" FontSize="12" FontWeight="SemiBold" Foreground="#36506F" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0" Classes="primary" Content="{loc:Loc webservers.action.start}" Command="{Binding StartManagedCommand}" HorizontalContentAlignment="Center" />
                                        <Button Grid.Column="1" Content="{loc:Loc webservers.action.stop}" Command="{Binding StopCommand}" HorizontalContentAlignment="Center" />
                                        <Button Grid.Column="2" Content="{loc:Loc webservers.action.restart}" Command="{Binding RestartCommand}" HorizontalContentAlignment="Center" />
                                        <Button Grid.Column="3" Content="{loc:Loc webservers.action.reload}" Command="{Binding ReloadCommand}" HorizontalContentAlignment="Center" />
                                    </Grid>
                                    <Border Background="#FFF7F7" BorderBrush="#F4D2D2" BorderThickness="1" CornerRadius="10" Padding="12,9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="卸载会停止并删除由 RemoteOS 管理的 Nginx。" FontSize="12" Foreground="#8A4B4B" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Button Grid.Column="1" Content="{loc:Loc webservers.managed.uninstall}" Command="{Binding UninstallManagedCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding TestResultText}" TextWrapping="Wrap" Foreground="#61708B" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="SitesPage" MaxWidth="1440" HorizontalAlignment="Stretch" Margin="32,28,32,32" Spacing="16" IsVisible="False">
                        <Border Background="White" CornerRadius="14" Padding="20">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="站点部署" FontSize="16" FontWeight="SemiBold" Foreground="#163059" />
                                    <TextBlock Text="创建站点会在单独的对话框中完成；选择列表中的站点后可继续编辑或删除。" FontSize="12" Foreground="#61708B" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="新建站点" Command="{Binding NewSiteCommand}" />
                                    <Button Content="编辑选中站点" Command="{Binding EditSiteCommand}" />
                                    <Button Content="删除选中站点" Command="{Binding DeleteSiteCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SiteStatusText}" TextWrapping="Wrap" Foreground="#61708B" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="14" Padding="20">
                            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                                <TextBlock Text="已部署站点" FontWeight="SemiBold" Foreground="#163059" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserReorderColumns="False"
                                          GridLinesVisibility="Horizontal" SelectionMode="Single" HorizontalScrollBarVisibility="Auto" MinHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称" Binding="{ReflectionBinding Name}" Width="150" />
                                        <DataGridTextColumn Header="类型" Binding="{ReflectionBinding Kind}" Width="110" />
                                        <DataGridTextColumn Header="域名" Binding="{ReflectionBinding Domains}" Width="*" />
                                        <DataGridTextColumn Header="服务地址" Binding="{ReflectionBinding Upstream}" Width="240" />
                                        <DataGridCheckBoxColumn Header="HTTPS" Binding="{ReflectionBinding HttpsEnabled}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
