<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:proxy="clr-namespace:Client.Apps.Proxy" x:Class="Client.Apps.Proxy.Views.ProxyOverviewView" x:DataType="proxy:ProxyManagerViewModel">
  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{loc:Loc proxy.runtime}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding RuntimeVersion}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding RuntimeState}" Foreground="{DynamicResource TextTertiaryBrush}" /></StackPanel></Border>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{loc:Loc proxy.health}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding HealthState}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding DnsState}" Foreground="{DynamicResource TextTertiaryBrush}" /></StackPanel></Border>
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{loc:Loc proxy.active_profile}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding ActiveProfileName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TunState}" Foreground="{DynamicResource TextTertiaryBrush}" /></StackPanel></Border>
    </Grid>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc proxy.quick_actions}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc proxy.quick_actions_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><WrapPanel><Button Classes="primary" Content="{loc:Loc proxy.start}" Command="{Binding StartProxyCommand}" Margin="0,0,8,8" /><Button Content="{loc:Loc proxy.restart}" Command="{Binding RestartProxyCommand}" Margin="0,0,8,8" /><Button Content="{loc:Loc proxy.stop}" Command="{Binding StopProxyCommand}" Margin="0,0,8,8" /></WrapPanel></StackPanel></Border>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.network_protection}" FontSize="19" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding RunningConnectionCount}" FontSize="20" FontWeight="SemiBold" /></Grid><TextBlock Text="{loc:Loc proxy.network_protection_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc proxy.recovery_required}" IsVisible="{Binding IsRecoveryRequired}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /></StackPanel></Border>
    </Grid>
    <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><TextBlock Text="{loc:Loc proxy.safety_hint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
  </StackPanel>
</UserControl>
