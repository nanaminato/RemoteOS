<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:proxy="clr-namespace:Client.Apps.Proxy" x:Class="Client.Apps.Proxy.Views.ProxyConnectionsView" x:DataType="proxy:ProxyManagerViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{loc:Loc proxy.connections}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc proxy.connections_hint}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel><Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" /></Grid><DataGrid ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" Height="390" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="{loc:Loc proxy.source}" Binding="{ReflectionBinding Source}" Width="190" /><DataGridTextColumn Header="{loc:Loc proxy.destination}" Binding="{ReflectionBinding Destination}" Width="*" /><DataGridTextColumn Header="{loc:Loc proxy.rule}" Binding="{ReflectionBinding Rule}" Width="180" /><DataGridTextColumn Header="{loc:Loc proxy.chain}" Binding="{ReflectionBinding Chains}" Width="180" /></DataGrid.Columns></DataGrid><Button Content="{loc:Loc proxy.close_connection}" Command="{Binding CloseConnectionCommand}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left" /></StackPanel></Border>
</UserControl>
