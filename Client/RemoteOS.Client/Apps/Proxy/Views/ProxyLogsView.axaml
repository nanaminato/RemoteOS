<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:proxy="clr-namespace:Client.Apps.Proxy" x:Class="Client.Apps.Proxy.Views.ProxyLogsView" x:DataType="proxy:ProxyManagerViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{loc:Loc proxy.logs}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc proxy.logs_hint}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel><Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" /></Grid><DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" Height="500" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="{loc:Loc proxy.time}" Binding="{ReflectionBinding Timestamp}" Width="200" /><DataGridTextColumn Header="{loc:Loc proxy.level}" Binding="{ReflectionBinding Level}" Width="100" /><DataGridTextColumn Header="{loc:Loc proxy.message}" Binding="{ReflectionBinding Message}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Border>
</UserControl>
