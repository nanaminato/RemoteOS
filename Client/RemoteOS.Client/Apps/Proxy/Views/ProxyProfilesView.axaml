<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:proxy="clr-namespace:Client.Apps.Proxy"
             xmlns:dto="clr-namespace:RemoteOS.Protocol.Proxy;assembly=RemoteOS.Protocol"
             x:Class="Client.Apps.Proxy.Views.ProxyProfilesView"
             x:DataType="proxy:ProxyManagerViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Loc proxy.subscriptions}" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Loc proxy.subscriptions_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="{loc:Loc proxy.subscription_update_all}" Command="{Binding UpdateAllSubscriptionsCommand}" Margin="0,0,8,0" />
        <Button Content="{loc:Loc proxy.subscription_view_runtime}" Command="{Binding ViewRuntimeSubscriptionsCommand}" Margin="0,0,8,0" />
        <Button Classes="primary" Content="{loc:Loc proxy.subscription_reactivate}" Command="{Binding ReactivateSubscriptionCommand}" />
      </WrapPanel>
    </Grid>

    <Border Grid.Row="1" IsVisible="{Binding RuntimeIsNotInstalled}" Background="{DynamicResource WarningMutedBrush}" CornerRadius="10" Padding="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <TextBlock Text="{loc:Loc proxy.subscription_runtime_required}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Content="{loc:Loc proxy.runtime_install}" Command="{Binding InstallRuntimeCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsEnabled="{Binding RuntimeIsInstalled}">
      <TextBox Text="{Binding SubscriptionLink, Mode=TwoWay}" PlaceholderText="{loc:Loc proxy.subscription_link}" />
      <Button Grid.Column="1" Content="{loc:Loc proxy.subscription_import}" Command="{Binding ImportSubscriptionCommand}" />
    </Grid>

    <ListBox Grid.Row="3"
             ItemsSource="{Binding VisibleSubscriptions}"
             SelectedItem="{Binding SelectedSubscription, Mode=TwoWay}"
             BorderThickness="0"
             Background="Transparent">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,16,16" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="dto:ProxySubscriptionDto">
          <Border Width="320"
                  MinHeight="176"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="18">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Background="{DynamicResource AccentMutedBrush}" CornerRadius="10" Padding="8,3">
                  <TextBlock Text="{loc:Loc proxy.subscription_runtime}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                </Border>
              </Grid>

              <TextBlock Grid.Row="1" Text="{loc:Loc proxy.subscription_source_configured}" Foreground="{DynamicResource TextSecondaryBrush}" />

              <StackPanel Grid.Row="2" Spacing="5">
                <TextBlock Text="{loc:Loc proxy.subscription_last_updated}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" />
                <TextBlock Text="{Binding LastUpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="13" />
              </StackPanel>

              <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{loc:Loc proxy.subscription_inactive}" IsVisible="{Binding !IsActive}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc proxy.subscription_active}" IsVisible="{Binding IsActive}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{loc:Loc proxy.subscription_reactivate}" Command="{Binding $parent[ListBox].DataContext.ReactivateSubscriptionCommand}" CommandParameter="{Binding}" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="4" IsVisible="{Binding IsRuntimeSubscriptionVisible}" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <TextBlock Text="{loc:Loc proxy.subscription_content}" FontSize="16" FontWeight="SemiBold" />
        <TextBox Grid.Row="1" Text="{Binding RuntimeSubscriptionText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" MinHeight="180" MaxHeight="260" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
