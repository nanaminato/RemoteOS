<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Client.Localization" xmlns:proxy="clr-namespace:Client.Apps.Proxy" x:Class="Client.Apps.Proxy.Views.ProxySettingsView" x:DataType="proxy:ProxyManagerViewModel">
  <StackPanel Spacing="18">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc proxy.runtime_settings}" FontSize="19" FontWeight="SemiBold" /><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="22" RowSpacing="10"><TextBlock Text="{loc:Loc proxy.engine}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding Overview.EngineId}" /><TextBlock Grid.Row="1" Text="{loc:Loc proxy.runtime}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeVersion}" /><TextBlock Grid.Row="2" Text="{loc:Loc proxy.runtime_state}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeState}" /></Grid><WrapPanel Margin="0,6,0,0"><Button Classes="primary" Content="{loc:Loc proxy.runtime_install}" Command="{Binding InstallRuntimeCommand}" Margin="0,0,8,8" /><Button Content="{loc:Loc proxy.runtime_install_from_server_file}" Command="{Binding InstallRuntimeFromServerFileCommand}" Margin="0,0,8,8" /><Button Content="{loc:Loc proxy.runtime_rollback}" Command="{Binding RollbackRuntimeCommand}" Margin="0,0,8,8" /><Button Content="{loc:Loc proxy.restart}" Command="{Binding RestartProxyCommand}" Margin="0,0,8,8" /></WrapPanel><TextBlock Text="{loc:Loc proxy.runtime_server_file_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc proxy.network_settings}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc proxy.network_settings_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="22" RowSpacing="10"><TextBlock Text="TUN" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding TunState}" /><TextBlock Grid.Row="1" Text="DNS" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DnsState}" /></Grid><WrapPanel Margin="0,6,0,0"><Button Content="{loc:Loc proxy.tun_disable}" Command="{Binding DisableTunCommand}" Margin="0,0,8,8" /><Button Content="{loc:Loc proxy.emergency_disable}" Command="{Binding EmergencyDisableCommand}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,8" /></WrapPanel></StackPanel></Border>
  </StackPanel>
</UserControl>
