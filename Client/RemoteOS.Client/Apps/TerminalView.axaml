<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Client.Apps"
             x:Class="Client.Apps.TerminalView"
             x:DataType="app:TerminalViewModel"
             Background="#0C0C0C">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="字体" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding FontFamilies}"
                          SelectedItem="{Binding FontFamily}"
                          MinWidth="132" />
                <TextBlock Text="字号" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox ItemsSource="{Binding FontSizes}"
                          SelectedItem="{Binding FontSize}"
                          MinWidth="64" />
                <TextBlock Text="配色" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox ItemsSource="{Binding ColorSchemes}"
                          SelectedItem="{Binding ColorScheme}"
                          MinWidth="128" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="TerminalHost" />
    </Grid>
</UserControl>
