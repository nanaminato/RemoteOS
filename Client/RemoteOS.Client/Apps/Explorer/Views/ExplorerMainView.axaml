<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:c="clr-namespace:Client.Apps.Explorer.Converters"
             xmlns:vm="clr-namespace:Client.Apps.Explorer.ViewModels"
             xmlns:d="clr-namespace:RemoteOS.Protocol.Files;assembly=RemoteOS.Protocol"
             x:Class="Client.Apps.Explorer.Views.ExplorerMainView"
             x:Name="Root"
             x:DataType="vm:ExplorerViewModel"
             Background="#FFFFFF">

    <UserControl.Resources>
        <!-- 文件/目录图标 -->
        <c:EntryTypeToGlyphConverter x:Key="TypeGlyphConverter" />
        <c:EntrySizeToStringConverter x:Key="SizeConverter" />
        <c:EntryTypeToStringConverter x:Key="TypeTextConverter" />
        <c:TreeNodeIconKindToGlyphConverter x:Key="NodeGlyphConverter" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- 顶部菜单栏（简化版） -->
        <Menu DockPanel.Dock="Top" IsVisible="{Binding !IsPickerMode}" Background="#F5F5F5" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
            <MenuItem Header="{loc:Loc explorer.menu.file}">
                <MenuItem Header="{loc:Loc explorer.menu.new_folder}" Command="{Binding NewFolderCommand}" InputGesture="Ctrl+Shift+N" />
                <MenuItem Header="{loc:Loc explorer.menu.upload}" Command="{Binding UploadCommand}" />
                <MenuItem Header="{loc:Loc explorer.menu.upload_folder}" Command="{Binding UploadFolderCommand}" />
                <MenuItem Header="{loc:Loc explorer.open_terminal}" Command="{Binding OpenTerminalCommand}" />
                <Separator />
                <MenuItem Header="{loc:Loc explorer.menu.exit}" Command="{Binding CloseCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc explorer.menu.edit}">
                <MenuItem Header="{loc:Loc explorer.menu.delete}" Command="{Binding DeleteCommand}" InputGesture="Delete" />
                <MenuItem Header="{loc:Loc explorer.menu.rename}" Command="{Binding RenameCommand}" InputGesture="F2" />
                <Separator />
                <MenuItem Header="{loc:Loc explorer.menu.copy}" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
                <MenuItem Header="{loc:Loc explorer.menu.cut}" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
                <MenuItem Header="{loc:Loc explorer.menu.paste}" Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                <MenuItem Header="{loc:Loc explorer.menu.paste_host}" Command="{Binding PasteFromHostCommand}" />
                <MenuItem Header="{loc:Loc explorer.menu.move}" Command="{Binding MoveCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc explorer.menu.view}">
                <MenuItem Header="{loc:Loc explorer.menu.refresh}" Command="{Binding RefreshCommand}" InputGesture="F5" />
            </MenuItem>
            <MenuItem Header="{loc:Loc explorer.menu.help}">
                <MenuItem Header="{loc:Loc explorer.menu.about}" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="icon" Content="←" Command="{Binding GoBackCommand}" ToolTip.Tip="{loc:Loc common.back}" />
                <Button Classes="icon" Content="→" Command="{Binding GoForwardCommand}" ToolTip.Tip="{loc:Loc common.forward}" />
                <Button Classes="icon" Content="↑" Command="{Binding GoUpCommand}" ToolTip.Tip="{loc:Loc explorer.up}" />
                <Button Classes="icon" Content="⟳" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc common.refresh}" />
                <StackPanel IsVisible="{Binding !IsPickerMode}" Orientation="Horizontal" Spacing="4">
                    <Separator Margin="6,0" />
                    <Button Content="{loc:Loc explorer.new_folder}" Command="{Binding NewFolderCommand}" Padding="12,6" />
                    <Button Content="{loc:Loc common.delete}" Command="{Binding DeleteCommand}" Padding="12,6" />
                    <Button Content="{loc:Loc common.rename}" Command="{Binding RenameCommand}" Padding="12,6" />
                    <Button Content="{loc:Loc explorer.copy}" Command="{Binding CopyCommand}" Padding="12,6" />
                    <Button Content="{loc:Loc explorer.cut}" Command="{Binding CutCommand}" Padding="12,6" />
                    <Button Content="{loc:Loc explorer.paste}" Command="{Binding PasteCommand}" Padding="12,6" />
                    <Separator Margin="6,0" />
                    <Button Content="{loc:Loc common.download}" Command="{Binding DownloadCommand}" Padding="12,6" />
                    <Button Content="{loc:Loc common.upload}" Command="{Binding UploadCommand}" Padding="12,6" />
                    <Button Content="{loc:Loc explorer.upload_folder}" Command="{Binding UploadFolderCommand}" Padding="12,6" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 地址栏 -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="📁" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="14" />
                <TextBox x:Name="AddressBox"
                         Text="{Binding AddressbarPath, Mode=TwoWay}"
                         PlaceholderText="{loc:Loc explorer.computer}"
                         IsReadOnly="False"
                         MinWidth="500"
                         KeyDown="AddressBox_KeyDown" />
                <Button Content="{loc:Loc common.go}" Click="GoButton_Click" Padding="16,6" />
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{Binding IsBusy, Converter={x:Static c:ExplorerLoadingStatusConverter.Instance}}"
                           FontSize="12" Opacity="0.6" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TransferText}" FontSize="12" Opacity="0.75"
                           Margin="0,5,10,0" IsVisible="{Binding HasTransferProgress}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Width="180" Height="6" Minimum="0" Maximum="100"
                             Value="{Binding TransferProgress}" Margin="0,7,0,0"
                             IsVisible="{Binding HasTransferProgress}" />
            </Grid>
        </Border>

        <!-- Picker mode reuses the full Explorer navigation surface and adds native-like confirmation fields. -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsPickerMode}"
                Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding PickerEntryLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PickerEntryName, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2" IsVisible="{Binding IsFilePickerMode}"
                              ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Width="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelPickerCommand}" />
                    <Button Classes="primary" Content="{Binding PickerConfirmLabel}" Command="{Binding ConfirmPickerCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左导航树 | 分隔 | 右条目列表 -->
        <Grid ColumnDefinitions="240,Auto,*">
            <!-- 导航树 -->
            <TreeView Grid.Column="0"
                      x:Name="NavigationTree"
                      ItemsSource="{Binding Nodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Explorer_DragOver"
                      DragDrop.Drop="Explorer_Drop">
                <!-- TreeViewItem 的 IsExpanded 不会自动与数据项同步。没有这条绑定时，
                     仅会展开不可见的 dummy child，TreeNodeModel 无法发起目录懒加载。 -->
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <!-- 编译绑定无法在 Style setter 中推断 TreeViewItem 的 DataContext 类型，
                             会回退到页面级 x:DataType(ExplorerViewModel) 而 AVLN2000 报错。
                             这里用 ReflectionBinding 显式退化为运行时反射绑定。 -->
                        <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <!-- Do not use a stretch column here: TreeViewItem headers inherit the
                             resized pane width and a star column can visually separate icon/text. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsPlaceholder}">
                            <TextBlock Text="{Binding IconKind, Converter={StaticResource NodeGlyphConverter}}"
                                       FontSize="13" Width="18" />
                            <TextBlock Text="{Binding Label}" Width="188" MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" Background="#E5E5E5" ResizeDirection="Columns" />

            <!-- File Explorer-style details view. Each column starts with a fixed width:
                 spare viewport space remains empty instead of stretching a column;
                 narrower viewports use the grid's horizontal scrollbar. Users can drag
                 the header dividers to change any column width. -->
            <DataGrid Grid.Column="2"
                      x:Name="EntriesGrid"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      SelectionMode="{Binding EntrySelectionMode}"
                      SelectionChanged="EntriesGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      GridLinesVisibility="None"
                      RowHeight="32"
                      ColumnHeaderHeight="30"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      DoubleTapped="EntriesGrid_DoubleTapped"
                      PointerPressed="EntriesGrid_PointerPressed"
                      PointerMoved="EntriesGrid_PointerMoved"
                      PointerReleased="EntriesGrid_PointerReleased"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Explorer_DragOver"
                      DragDrop.Drop="Explorer_Drop">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding #EntriesGrid.DataContext}">
                        <MenuItem Header="{loc:Loc common.open}" Command="{Binding OpenCommand}" />
                        <MenuItem Header="{loc:Loc explorer.open_with}" Command="{Binding OpenWithSelectedCommand}" />
                        <MenuItem Header="{loc:Loc explorer.open_terminal}" Command="{Binding OpenTerminalCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc explorer.copy}" Command="{Binding CopyCommand}" />
                        <MenuItem Header="{loc:Loc explorer.cut}" Command="{Binding CutCommand}" />
                        <MenuItem Header="{loc:Loc explorer.paste}" Command="{Binding PasteCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc common.rename}" Command="{Binding RenameCommand}" />
                        <MenuItem Header="{loc:Loc common.delete}" Command="{Binding DeleteCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc explorer.properties}" Command="{Binding PropertiesCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FAFAFA" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                    </Style>
                    <Style Selector="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Loc common.name}" Width="300" MinWidth="180" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="12,2">
                                    <TextBlock Text="💾" FontSize="14" IsVisible="{Binding Type, Converter={StaticResource TypeGlyphConverter}, ConverterParameter=drive}" />
                                    <TextBlock Text="📁" FontSize="14" IsVisible="{Binding Type, Converter={StaticResource TypeGlyphConverter}, ConverterParameter=dir}" />
                                    <TextBlock Text="📄" FontSize="14" IsVisible="{Binding Type, Converter={StaticResource TypeGlyphConverter}, ConverterParameter=file}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc explorer.size}" Width="112" MinWidth="96" SortMemberPath="Size">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding Size, Converter={StaticResource SizeConverter}}" Padding="8,0"
                                           FontSize="12" Opacity="0.8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc explorer.modified}" Width="164" MinWidth="150" SortMemberPath="Modified">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding Modified, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Padding="8,0"
                                           FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc common.type}" Width="120" MinWidth="96" SortMemberPath="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding Type, Converter={StaticResource TypeTextConverter}}" Padding="8,0"
                                           FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
