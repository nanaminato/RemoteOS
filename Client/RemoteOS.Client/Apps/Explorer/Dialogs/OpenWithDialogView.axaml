<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Client.Apps.Explorer.Dialogs"
             xmlns:core="clr-namespace:RemoteOS.Core.Applications;assembly=RemoteOS.Core"
             x:Class="Client.Apps.Explorer.Dialogs.OpenWithDialogView"
             x:DataType="vm:OpenWithDialogViewModel"
             Background="#FFFFFF" Width="440">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20" RowSpacing="10">
        <TextBlock Text="Choose an application to open this file:" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication, Mode=TwoWay}" MinHeight="140">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:ApplicationInfo">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,4">
                        <TextBlock Text="{Binding IconGlyph}" />
                        <TextBlock Text="{Binding DisplayName}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <CheckBox Grid.Row="2" IsChecked="{Binding SetAsDefault, Mode=TwoWay}"
                  Content="Always use this application for this extension" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,6" />
            <Button Classes="primary" Content="Open" Command="{Binding OpenCommand}" Padding="16,6" />
        </StackPanel>
    </Grid>
</UserControl>
