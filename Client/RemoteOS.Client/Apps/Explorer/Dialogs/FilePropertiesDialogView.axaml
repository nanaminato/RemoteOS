<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:vm="clr-namespace:Client.Apps.Explorer.Dialogs"
             x:Class="Client.Apps.Explorer.Dialogs.FilePropertiesDialogView"
             x:DataType="vm:FilePropertiesDialogViewModel"
             Background="#FFFFFF" Width="560" MaxHeight="620">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding Properties.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Properties.Path}" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Loc explorer.properties.general}" FontSize="15" FontWeight="SemiBold" />
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="24">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Loc common.type}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Type}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.size}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding SizeText}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.created}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Created, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.modified}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Modified, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.accessed}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Accessed, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.attributes}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Attributes}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.permissions_summary}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Permissions}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16"
                    IsVisible="{Binding CanEditPermissions}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.linux_permissions}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc explorer.properties.permissions_note}" FontSize="12" Opacity="0.62" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E0E7FF" CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                            <TextBlock Text="{Binding PermissionOctal}" FontFamily="Consolas" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Background="#FFFFFF" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{loc:Loc explorer.properties.owner}" FontWeight="SemiBold" />
                                <CheckBox Content="{loc:Loc explorer.permission.read}" IsChecked="{Binding OwnerRead}" />
                                <CheckBox Content="{loc:Loc explorer.permission.write}" IsChecked="{Binding OwnerWrite}" />
                                <CheckBox Content="{loc:Loc explorer.permission.execute}" IsChecked="{Binding OwnerExecute}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{loc:Loc explorer.properties.group}" FontWeight="SemiBold" />
                                <CheckBox Content="{loc:Loc explorer.permission.read}" IsChecked="{Binding GroupRead}" />
                                <CheckBox Content="{loc:Loc explorer.permission.write}" IsChecked="{Binding GroupWrite}" />
                                <CheckBox Content="{loc:Loc explorer.permission.execute}" IsChecked="{Binding GroupExecute}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{loc:Loc explorer.properties.others}" FontWeight="SemiBold" />
                                <CheckBox Content="{loc:Loc explorer.permission.read}" IsChecked="{Binding OthersRead}" />
                                <CheckBox Content="{loc:Loc explorer.permission.write}" IsChecked="{Binding OthersWrite}" />
                                <CheckBox Content="{loc:Loc explorer.permission.execute}" IsChecked="{Binding OthersExecute}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding PermissionStatus}" FontSize="12" Opacity="0.72" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{loc:Loc explorer.save_permissions}" Command="{Binding SavePermissionsCommand}"
                                Classes="primary" Padding="16,7" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#F8FAFC" CornerRadius="8" Padding="12" IsVisible="{Binding !CanEditPermissions}">
                <TextBlock Text="{loc:Loc explorer.properties.permissions_unsupported}"
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </Border>

            <Button Content="{loc:Loc common.close}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Padding="20,7" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
