<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:certificates="clr-namespace:Client.Apps.Certificates"
             x:Class="Client.Apps.Certificates.Views.CertificateOverviewView"
             x:DataType="certificates:CertificateManagerViewModel">
    <StackPanel Spacing="18">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <Border Background="White" CornerRadius="14" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc certificates.overview.total}" Foreground="#61708B" FontSize="12" />
                    <TextBlock Text="{Binding Certificates.Count}" FontSize="28" FontWeight="SemiBold" Foreground="#163059" />
                    <TextBlock Text="{loc:Loc certificates.overview.total_hint}" Foreground="#61708B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc certificates.overview.actions}" Foreground="#61708B" FontSize="12" />
                    <Button Classes="primary" Content="{loc:Loc certificates.request.title}" Click="RequestCertificate_Click" HorizontalAlignment="Left" />
                    <Button Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Background="White" CornerRadius="14" Padding="20">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc certificates.overview}" FontSize="19" FontWeight="SemiBold" Foreground="#163059" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#61708B" />
                <TextBlock Text="{loc:Loc certificates.overview.safety_hint}" TextWrapping="Wrap" Foreground="#315582" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
