<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Client.Apps"
             x:Class="Client.Apps.FilePickerView"
             x:DataType="app:FilePickerViewModel"
             Background="#FFFFFF">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*">
            <Button Content="上一级" Command="{Binding UpCommand}" />
            <TextBox Grid.Column="1" Margin="10,0,0,0" Text="{Binding CurrentPath}" IsReadOnly="True" />
        </Grid>
        <TextBlock Grid.Row="1" Text="选择模式：选择一个文件后点击“选择”" Foreground="#666666" FontSize="12" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                 BorderBrush="#D6D6D6" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:FilePickerEntry">
                    <Grid ColumnDefinitions="34,*" Margin="6,3">
                        <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" FontSize="12" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="选择" Command="{Binding SelectCommand}" />
        </Grid>
    </Grid>
</UserControl>
