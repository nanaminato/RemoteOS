<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Client.Views.Shell"
        xmlns:vm="clr-namespace:Client.ViewModels.Shell"
        x:Class="Client.Views.MainWindow"
        x:DataType="vm:DesktopShellViewModel"
        Title="RemoteOS"
        WindowState="Maximized"
        WindowDecorations="None"
        CanResize="True"
        MinWidth="800"
        MinHeight="520"
        ShowInTaskbar="True"
        Background="#F6F6F6"
        FontFamily="{StaticResource ContentFont}"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Window.Styles>
        <Style Selector="Border.connection-bar">
            <Setter Property="Background" Value="#F9F9F9" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0,0,7,7" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #33000000" />
        </Style>
        <Style Selector="Button.connection-action">
            <Setter Property="Foreground" Value="#2A2A2A" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.connection-action:pointerover">
            <Setter Property="Background" Value="#E5E5E5" />
        </Style>
        <Style Selector="Button.disconnect-action:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Border.window-titlebar">
            <Setter Property="Background" Value="#F3F3F3" />
        </Style>
        <Style Selector="Button.window-control">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="#2A2A2A" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#E1E1E1" />
        </Style>
        <Style Selector="Button.window-close:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
    </Window.Styles>

    <Grid PointerMoved="Root_OnPointerMoved">
        <Grid x:Name="Root" PointerMoved="Root_OnPointerMoved">
            <shell:DesktopShellView />
        </Grid>

        <!-- The title bar and mstsc connection bar deliberately share the same top layer. -->
        <Border x:Name="WindowTitleBar" Classes="window-titlebar" Height="34"
                VerticalAlignment="Top" PointerPressed="TitleBar_OnPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="26" Height="26" Background="#1976C2" Margin="8,0,6,0" CornerRadius="4"
                        VerticalAlignment="Center">
                    <TextBlock Text="R" Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="RemoteOS 远程桌面" Foreground="#2A2A2A" FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="window-control" Content="&#xE921;" Click="Minimize_OnClick" ToolTip.Tip="最小化" />
                    <Button x:Name="MaximizeButton" Classes="window-control" Content="&#xE922;"
                            Click="Maximize_OnClick" ToolTip.Tip="最大化" />
                    <Button Classes="window-control window-close" Content="&#xE8BB;"
                            Click="CloseWindow_OnClick" ToolTip.Tip="关闭连接" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- mstsc-style connection bar. The centre is intentionally reserved for future actions. -->
        <Border x:Name="ConnectionBar" Classes="connection-bar"
                HorizontalAlignment="Center" VerticalAlignment="Top" Width="520" Height="34"
                PointerEntered="ConnectionBar_OnPointerEntered"
                PointerExited="ConnectionBar_OnPointerExited">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <Button Grid.Column="0" Classes="connection-action" Click="ConnectionInfo_OnClick"
                        ToolTip.Tip="查看连接信息">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="{Binding ConnectionServer}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="1" Width="1" Background="#D6D6D6" Margin="0,7" />
                <Button Grid.Column="2" x:Name="PinButton" Classes="connection-action" Click="Pin_OnClick"
                        Content="固定" ToolTip.Tip="固定连接栏" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" />
                <Button Grid.Column="4" x:Name="FullScreenButton" Classes="connection-action"
                        Click="FullScreen_OnClick" Content="全屏" ToolTip.Tip="进入全屏" />
                <Border Grid.Column="5" Width="1" Background="#D6D6D6" Margin="0,7" />
                <Button Grid.Column="6" Classes="connection-action disconnect-action" Click="Disconnect_OnClick"
                        Content="关闭连接" ToolTip.Tip="断开连接并退出" />
            </Grid>
        </Border>

        <Border x:Name="ConnectionInfo" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Width="360" Margin="0,42,0,0"
                Background="#F9F9F9" BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="4"
                BoxShadow="0 8 18 0 #66000000" Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="连接信息" FontWeight="SemiBold" FontSize="14" />
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="服务器" Foreground="#666666" />
                    <TextBlock Grid.Column="1" Text="{Binding ConnectionServer}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="用户" Foreground="#666666" Margin="0,7,0,0" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ConnectionUser}" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Text="工作区" Foreground="#666666" Margin="0,7,0,0" />
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding ConnectionWorkspace}" Margin="0,7,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Transparent hit targets keep every edge and corner resizable. -->
        <Border HorizontalAlignment="Left" Width="8" Background="Transparent" Cursor="SizeWestEast"
                PointerPressed="Resize_OnPointerPressed" Tag="West" />
        <Border HorizontalAlignment="Right" Width="8" Background="Transparent" Cursor="SizeWestEast"
                PointerPressed="Resize_OnPointerPressed" Tag="East" />
        <Border VerticalAlignment="Top" Height="8" Background="Transparent" Cursor="SizeNorthSouth"
                PointerPressed="Resize_OnPointerPressed" Tag="North" />
        <Border VerticalAlignment="Bottom" Height="8" Background="Transparent" Cursor="SizeNorthSouth"
                PointerPressed="Resize_OnPointerPressed" Tag="South" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12" Background="Transparent"
                Cursor="TopLeftCorner" PointerPressed="Resize_OnPointerPressed" Tag="NorthWest" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12" Background="Transparent"
                Cursor="TopRightCorner" PointerPressed="Resize_OnPointerPressed" Tag="NorthEast" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12" Background="Transparent"
                Cursor="BottomLeftCorner" PointerPressed="Resize_OnPointerPressed" Tag="SouthWest" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Background="Transparent"
                Cursor="BottomRightCorner" PointerPressed="Resize_OnPointerPressed" Tag="SouthEast" />
    </Grid>
</Window>
