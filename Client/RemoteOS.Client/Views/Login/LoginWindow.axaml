<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:login="clr-namespace:Client.Views.Login"
        x:Class="Client.Views.Login.LoginWindow"
        Title="RemoteOS - 连接"
        Width="460" Height="620"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource ContentFont}">
    <login:LoginView />
</Window>
