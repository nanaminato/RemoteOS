<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RemoteOS.Sketch.Client.MainWindow" Width="1180" Height="760" MinWidth="900" MinHeight="600" Title="RemoteOS Sketch">
  <Grid ColumnDefinitions="220,*" Background="#F7F8FA">
    <Border Background="#172033" Padding="18"><StackPanel Spacing="8"><TextBlock Text="RemoteOS" FontSize="23" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Server management sketch" Opacity=".72" Foreground="White" Margin="0,0,0,20"/>
      <Button Content="Overview" Click="ShowOverview"/><Button Content="🐳  Docker Manager" Click="ShowDocker"/><Button Content="🌐  Nginx Manager" Click="ShowNginx"/><Button Content="🔐  Certificate Manager" Click="ShowCertificates"/>
      <Border Height="1" Background="#60708D" Margin="0,18"/><TextBlock Text="Mock login: design-user" Foreground="White" Opacity=".75" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <ScrollViewer Grid.Column="1"><StackPanel Margin="34" Spacing="18">
      <StackPanel x:Name="OverviewPage" Spacing="14"><TextBlock Text="Server Overview" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionStatus" Text="Mock Server · connecting with design-user…" Opacity=".7"/><WrapPanel ItemWidth="230" ItemHeight="110"><Border Background="White" Margin="0,0,14,14" Padding="16"><StackPanel><TextBlock Text="Docker" FontWeight="SemiBold"/><TextBlock Text="Installed · 3 containers running" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" Margin="0,0,14,14" Padding="16"><StackPanel><TextBlock Text="Nginx" FontWeight="SemiBold"/><TextBlock Text="Not installed" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" Margin="0,0,14,14" Padding="16"><StackPanel><TextBlock Text="Certificates" FontWeight="SemiBold"/><TextBlock Text="ACME client not ready" Margin="0,8,0,0"/></StackPanel></Border></WrapPanel></StackPanel>
      <StackPanel x:Name="DockerPage" IsVisible="False" Spacing="12"><TextBlock Text="Docker Manager" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Docker Engine 27.1.1 · Installed" Foreground="#14804A"/><TextBlock Text="Containers" FontSize="18" FontWeight="SemiBold"/><Border Background="White" Padding="14"><TextBlock Text="remoteos-web     nginx:1.27              Running     80:80, 443:443&#x0a;remoteos-api      remoteos/server:sketch  Running     5000:8080&#x0a;postgres          postgres:16             Stopped     5432:5432" FontFamily="Consolas" LineHeight="26"/></Border></StackPanel>
      <StackPanel x:Name="NginxPage" IsVisible="False" Spacing="12"><TextBlock Text="Nginx Manager" FontSize="28" FontWeight="SemiBold"/><Border Background="White" Padding="24"><StackPanel Spacing="10"><TextBlock Text="Nginx is not installed" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Install Nginx before managing sites, reverse proxies, configuration versions, and logs." TextWrapping="Wrap"/><TextBlock Text="Getting started" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="1. Review your platform and the official Nginx installation guide.&#x0a;2. An administrator installs and starts Nginx.&#x0a;3. Refresh this page to verify service status." TextWrapping="Wrap" LineHeight="25"/><TextBlock Text="Production will use a reviewed install plan, never user-provided shell text." Opacity=".68" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
      <StackPanel x:Name="CertificatesPage" IsVisible="False" Spacing="12"><TextBlock Text="Certificate Manager" FontSize="28" FontWeight="SemiBold"/><Border Background="White" Padding="24"><StackPanel Spacing="10"><TextBlock Text="Certificate service is not ready" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="This page will issue and renew HTTPS certificates after an approved ACME client is available." TextWrapping="Wrap"/><TextBlock Text="Getting started" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="1. Install a supported ACME client.&#x0a;2. Prepare DNS or HTTP-01 validation.&#x0a;3. Verify the service before issuing a certificate." TextWrapping="Wrap" LineHeight="25"/><TextBlock Text="Private keys and DNS credentials stay in server-side secure storage." Opacity=".68" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
