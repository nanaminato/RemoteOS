{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "REPLACE_IN_PRODUCTION_at_least_32_chars_long_random__",
    "Issuer": "RemoteOS.Server",
    "Audience": "RemoteOS.Client",
    "AccessTokenTtl": "00:15:00",
    "RefreshTokenTtl": "7.00:00:00"
  },
  "Storage": {
    "Provider": "sqlite",
    "DatabasePath": "data/remoteos.db"
  }
}
