#!/usr/bin/env bash
set -euo pipefail

# This file is installed root:root (0755) by install-remoteos-services.sh and is
# only executable by RemoteOS Server through a matching sudoers rule.  Keep this
# interface small: it is the complete privilege boundary for Firewall.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
IFS=$' \t\n'
readonly UFW=/usr/sbin/ufw

fail() {
  echo "remoteos-firewall-helper: invalid request" >&2
  exit 64
}

[[ ${EUID} -eq 0 ]] || { echo "remoteos-firewall-helper: root is required" >&2; exit 77; }
[[ -x "$UFW" ]] || { echo "remoteos-firewall-helper: ufw is not installed" >&2; exit 69; }

is_port() {
  local value=$1 first last
  [[ $value == any ]] && return 0
  [[ $value =~ ^[0-9]+(:[0-9]+)?$ ]] || return 1
  first=${value%%:*}
  last=${value##*:}
  (( 10#$first >= 1 && 10#$first <= 65535 && 10#$last >= 1 && 10#$last <= 65535 && 10#$first <= 10#$last ))
}

# This deliberately accepts only characters that can occur in an IP/CIDR. UFW
# performs the final IPv4/IPv6 semantic validation; no value is ever evaluated
# by a shell or used as an executable path.
is_endpoint() {
  local value=$1 address prefix
  [[ $value == any ]] && return 0
  [[ $value =~ ^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$ ]] || return 1
  address=${value%%/*}
  [[ -n $address ]] || return 1
  if [[ $value == */* ]]; then
    prefix=${value##*/}
    if [[ $address == *:* ]]; then
      (( 10#$prefix <= 128 ))
    else
      (( 10#$prefix <= 32 ))
    fi
  fi
}

run_rule() {
  local action=$1 direction=$2 protocol=$3 source=$4 destination=$5 port=$6
  [[ $action =~ ^(allow|deny|reject|limit)$ ]] || fail
  [[ $direction =~ ^(in|out)$ ]] || fail
  [[ $protocol =~ ^(tcp|udp|any)$ ]] || fail
  is_endpoint "$source" && is_endpoint "$destination" && is_port "$port" || fail

  local -a arguments=("$action" "$direction")
  [[ $protocol == any ]] || arguments+=(proto "$protocol")
  [[ $source == any ]] || arguments+=(from "$source")
  [[ $destination == any ]] || arguments+=(to "$destination")
  [[ $port == any ]] || arguments+=(port "$port")
  exec "$UFW" "${arguments[@]}"
}

replace_rule() {
  local number=$1 action=$2 direction=$3 protocol=$4 source=$5 destination=$6 port=$7
  [[ $number =~ ^[1-9][0-9]{0,3}$ ]] || fail
  [[ $action =~ ^(allow|deny|reject|limit)$ ]] || fail
  [[ $direction =~ ^(in|out)$ ]] || fail
  [[ $protocol =~ ^(tcp|udp|any)$ ]] || fail
  is_endpoint "$source" && is_endpoint "$destination" && is_port "$port" || fail

  local -a arguments=(insert "$number" "$action" "$direction")
  [[ $protocol == any ]] || arguments+=(proto "$protocol")
  [[ $source == any ]] || arguments+=(from "$source")
  [[ $destination == any ]] || arguments+=(to "$destination")
  [[ $port == any ]] || arguments+=(port "$port")
  "$UFW" --force delete "$number"
  exec "$UFW" "${arguments[@]}"
}

case "${1:-}" in
  version)
    [[ $# -eq 1 ]] || fail
    exec "$UFW" --version
    ;;
  status-verbose)
    [[ $# -eq 1 ]] || fail
    exec "$UFW" status verbose
    ;;
  status-numbered)
    [[ $# -eq 1 ]] || fail
    exec "$UFW" status numbered
    ;;
  enable|disable)
    [[ $# -eq 1 ]] || fail
    exec "$UFW" --force "$1"
    ;;
  default)
    [[ $# -eq 3 ]] || fail
    [[ $2 =~ ^(allow|deny|reject)$ && $3 =~ ^(incoming|outgoing)$ ]] || fail
    exec "$UFW" default "$2" "$3"
    ;;
  rule)
    [[ $# -eq 7 ]] || fail
    run_rule "$2" "$3" "$4" "$5" "$6" "$7"
    ;;
  replace)
    [[ $# -eq 8 ]] || fail
    replace_rule "$2" "$3" "$4" "$5" "$6" "$7" "$8"
    ;;
  delete)
    [[ $# -eq 2 && $2 =~ ^[1-9][0-9]{0,3}$ ]] || fail
    exec "$UFW" --force delete "$2"
    ;;
  verify)
    [[ $# -eq 1 ]] || fail
    exec "$UFW" --version
    ;;
  *) fail ;;
esac
