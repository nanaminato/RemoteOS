<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RemoteOS.Server/RemoteOS.Server.csproj" Condition="'$(UsePrebuiltServerAssembly)' != 'true'" />
    <!-- The local desktop SDK currently lacks workload locator SDKs. This opt-in path permits
         the smoke test to run against a just-built Server assembly without weakening CI's normal
         project-reference build. -->
    <Reference Include="RemoteOS.Server" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/RemoteOS.Server.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/Microsoft.Data.Sqlite.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
