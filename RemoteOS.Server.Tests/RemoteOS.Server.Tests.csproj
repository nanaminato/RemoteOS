<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PrebuiltServerAssemblyPath Condition="'$(PrebuiltServerAssemblyPath)' == ''">../RemoteOS.Server/bin/Debug/net10.0/RemoteOS.Server.dll</PrebuiltServerAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RemoteOS.Server/RemoteOS.Server.csproj" Condition="'$(UsePrebuiltServerAssembly)' != 'true'" />
    <!-- The local desktop SDK currently lacks workload locator SDKs. This opt-in path permits
         the smoke test to run against a just-built Server assembly without weakening CI's normal
         project-reference build. -->
    <Reference Include="RemoteOS.Server" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>$(PrebuiltServerAssemblyPath)</HintPath>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/Microsoft.Data.Sqlite.dll</HintPath>
    </Reference>
    <!-- Prebuilt mode must also expose the Server's compile-time API surface, not merely its
         implementation assembly. This keeps the local smoke suite runnable on SDKs where
         project-reference workload resolution is unavailable. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(UsePrebuiltServerAssembly)' == 'true'" />
    <Reference Include="RemoteOS.Protocol" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../Shared/RemoteOS.Protocol/bin/Debug/net10.0/RemoteOS.Protocol.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/Microsoft.EntityFrameworkCore.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
